/**
 * DRAFT/SUBMITTED are manually set by the engineer. PASSED is a manual certification action
 * (must be SUBMITTED first). PARTLY_PAID/FULLY_PAID are never set directly — they're derived
 * automatically from amountReceived vs netPayable the moment a payment is recorded against a
 * PASSED bill (see deriveRunningBillStatus in running-bill.service.ts).
 */
enum BillStatus {
  DRAFT
  SUBMITTED
  PASSED
  PARTLY_PAID
  FULLY_PAID
}

enum BillType {
  RA_BILL
  FINAL_BILL
  ADVANCE_BILL
}

enum DeductionType {
  SECURITY_DEPOSIT
  // Legacy single GST value — kept for historical rows only. New Form 58 bills use
  // GST_STATE/GST_CENTRAL below instead (the split can't be reconstructed retroactively for
  // rows already recorded against this value).
  GST
  GST_STATE
  GST_CENTRAL
  LABOUR_CESS
  ROYALTY
  TDS
  // Separate from TDS per business confirmation — Income Tax and TDS are two distinct
  // deductions on Form 58, not the same withholding recorded twice.
  INCOME_TAX
  MOBILIZATION_RECOVERY
  INSURANCE
  MSEB
  FINE
  OTHER
}

enum MeasurementBookStatus {
  DRAFT
  SUBMITTED
  APPROVED
}

enum InventoryStatus {
  HEALTHY
  LOW
  CRITICAL
  OUT_OF_STOCK
}

enum StockMovementType {
  OPENING
  RECEIPT
  ISSUE
  ADJUSTMENT
}

enum VendorBillStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum BankAccountType {
  BANK
  CASH
}

/**
 * UNALLOCATED: no TransactionAllocation rows yet. FULLY_ALLOCATED: allocations sum to the
 * transaction's full amount. PARTIALLY_ALLOCATED: some but not all of the amount has a
 * declared purpose yet — flagged for follow-up, never silently treated as fully allocated.
 */
enum AllocationStatus {
  UNALLOCATED
  PARTIALLY_ALLOCATED
  FULLY_ALLOCATED
}

enum BankTransactionSource {
  MANUAL
  IMPORTED
}

/**
 * The 12 purposes a bank Deposit/Withdrawal can be allocated to. RUNNING_BILL_RECEIPT/
 * VENDOR_PAYMENT/LABOUR/SITE_EXPENSE/OWNER_INVESTMENT/PARTNER_INVESTMENT/PARTNER_SETTLEMENT each
 * auto-create their real ledger row (RunningBillPayment/VendorPayment/LabourPayment/Expense/
 * PartnerInvestment/PartnerSettlement) — see TransactionAllocation. OWNER_INVESTMENT and
 * PARTNER_INVESTMENT both create a PartnerInvestment row (the Partner's own partnerType
 * distinguishes an Owner from a Partner — there's no separate "OwnerInvestment" table). The
 * remaining 4 types (Internal Transfer/GST/Loan/Office Expense/Other) have no dedicated ledger
 * yet, so the allocation row itself IS the ledger entry for those.
 */
enum AllocationType {
  RUNNING_BILL_RECEIPT
  VENDOR_PAYMENT
  LABOUR
  SITE_EXPENSE
  INTERNAL_TRANSFER
  OWNER_INVESTMENT
  PARTNER_INVESTMENT
  PARTNER_SETTLEMENT
  GST
  LOAN
  OFFICE_EXPENSE
  OTHER
  LIABILITY_DISBURSEMENT
  LIABILITY_REPAYMENT
  // Employee — tag-only (employeeId on the allocation row), no dedicated ledger; Employee
  // Reports read straight off these allocations (see EmployeeReport comment further down).
  EMPLOYEE_SALARY
  SITE_ADVANCE
  PERSONAL_ADVANCE
  // Banking — tag-only, no extra entity beyond the BankTransaction's own companyBankAccountId.
  OD_CC_INTEREST
  BANK_CHARGES
  INTEREST_INCOME
  // Loans — behave exactly like LIABILITY_REPAYMENT (require liabilityId, principal/interest
  // split, create a LiabilityRepayment row) — see LOAN_REPAYMENT_TYPES in
  // transaction-allocation.service.ts. These are just more specific "why" labels on top of the
  // same mechanism, filtered to the matching Liability.liabilityType in the picker.
  CAR_LOAN_EMI
  HOME_LOAN_EMI
  GOLD_LOAN
  EMERGENCY_LOAN
  OTHER_LOAN
  // Security Deposit released back to a contractor — tag-only, requires siteId (already a
  // first-class field on this model, same as SITE_EXPENSE). SD Deducted comes from
  // RunningBillDeduction rows of type SECURITY_DEPOSIT on that site's bills; SD Released is the
  // sum of these allocations; SD Pending is always Deducted minus Released, computed on demand
  // in deduction-ledger.service.ts — never stored.
  SECURITY_DEPOSIT_RELEASE
  // Payment Purpose Allocation (Executive Dashboard milestone). CLIENT_REFUND is tag-only
  // (requires siteId, same shape as SECURITY_DEPOSIT_RELEASE) — money paid back to a client,
  // no dedicated ledger table. CREDIT_CARD_BILL_PAYMENT behaves exactly like LIABILITY_REPAYMENT
  // (added to LOAN_REPAYMENT_TYPES), filtered to Liability.liabilityType = CREDIT_CARD.
  CLIENT_REFUND
  CREDIT_CARD_BILL_PAYMENT
}

enum LiabilityType {
  HOME_LOAN
  CAR_LOAN
  GOLD_LOAN
  BANK_LOAN
  CASH_CREDIT
  OVERDRAFT
  CREDIT_CARD
  FRIEND_LOAN
  RELATIVE_LOAN
  PRIVATE_FINANCE
  PERSONAL_LOAN
  OTHER
}

enum LiabilityInterestType {
  MONTHLY
  ANNUAL
  FIXED
  FLOATING
  NONE
}

enum LiabilitySecurity {
  HOUSE
  GOLD
  VEHICLE
  NONE
  OTHER
}

enum LiabilityStatus {
  ACTIVE
  CLOSED
}

enum PartnerType {
  OWNER
  PARTNER
}

enum SettlementType {
  PROFIT_SHARE
  INVESTMENT_RETURN
  OTHER
}

