  phone     String?
  address   String?
  city      String?
  state     String?
  country   String?
  pincode   String?
  logo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                 User[]
  roles                 Role[]
  clients               Client[]
  projectTypes          ProjectType[]
  projects              Project[]
  vendors               Vendor[]
  purchaseRequisitions  PurchaseRequisition[]
  purchaseOrders        PurchaseOrder[]
  materialReceipts      MaterialReceipt[]
  inventoryEntries      Inventory[]
  materialIssues        MaterialIssue[]
  stockLedgerEntries    StockLedgerEntry[]
  labours               Labour[]
  equipments            Equipment[]
  runningBills          RunningBill[]
  measurementBooks      MeasurementBook[]
  expenses              Expense[]
  payments              Payment[]
  documents             Document[]
  vendorBills           VendorBill[]
  vendorBankAccounts    VendorBankAccount[]
  bankAccounts          CompanyBankAccount[]
  vendorPayments        VendorPayment[]
  expenseCategories     ExpenseCategory[]
  labourGroups          LabourGroup[]
  labourWageRates       LabourWageRate[]
  labourAttendances     LabourAttendance[]
  labourAdvances        LabourAdvance[]
  labourPayments        LabourPayment[]
  subWorks              SubWork[]
  dailyProgressReports  DailyProgressReport[]
  dprVisitors           DPRVisitor[]
  dprSiteProblems       DPRSiteProblem[]
  dprEmailLogs          DPREmailLog[]
  measurementBookItems  MeasurementBookItem[]
  mbEmailLogs           MBEmailLog[]
  runningBillItems      RunningBillItem[]
  runningBillDeductions RunningBillDeduction[]
  runningBillPayments   RunningBillPayment[]
  runningBillEmailLogs  RunningBillEmailLog[]
  bankTransactions      BankTransaction[]
  bankStatementMappings BankStatementMapping[]
  transactionAllocations TransactionAllocation[]
  partners              Partner[]
  partnerInvestments    PartnerInvestment[]
  partnerSettlements    PartnerSettlement[]
  sites                 Site[]
  siteRecapRevisions    SiteRecapRevision[]
  siteTenderPercentChangeLogs SiteTenderPercentChangeLog[]
  workOrderExtensions   WorkOrderExtension[]
  siteVisits            SiteVisit[]
  liabilities           Liability[]
  employees             Employee[]
  bankAccountMasters    BankAccountMaster[]
  bankStatementImports  BankStatementImport[]
  bankStatementAuditLogs BankStatementAuditLog[]
  siteBillItems         SiteBillItem[]
  liabilityRepayments   LiabilityRepayment[]
  recapitulationItems   RecapitulationItem[]
  measurementItemFieldAudits MeasurementItemFieldAudit[]
}

model CompanyBankAccount {
  id              String          @id @default(cuid())
  companyId       String
  company         Company         @relation(fields: [companyId], references: [id])
  nickname        String?
  beneficiaryName String?
  bankName        String
  accountNumber   String
  ifscCode        String
  branch          String?
  upiId           String?
  // BANK is a real bank account; CASH represents "Cash in Hand". accountType is orthogonal to
  // isPrimary/isActive ("Account Status") which already existed. Current Balance is never
  // stored — it's always openingBalance + sum(BankTransaction.deposit) - sum(withdrawal),
  // computed on demand in bank-transaction.service.ts, mirroring the "never store a derivable
  // total" convention used by SubWork's budget/actual-cost fields.
  accountType     BankAccountType @default(BANK)
  openingBalance  Decimal         @default(0) @db.Decimal(14, 2)
  isPrimary       Boolean         @default(false)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  vendorPayments      VendorPayment[]
  expenses            Expense[]
  labourAdvances      LabourAdvance[]
  labourPayments      LabourPayment[]
  runningBillPayments RunningBillPayment[]
  bankTransactions    BankTransaction[]
  partnerInvestments  PartnerInvestment[]
  partnerSettlements  PartnerSettlement[]
  liabilityRepayments LiabilityRepayment[]
  bankStatementImports BankStatementImport[]

  @@index([companyId])
}

model Role {
  id        String   @id @default(cuid())
  name      UserRole
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, companyId])
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  active    Boolean  @default(true)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdExpenses            Expense[]
  createdMaterialIssues      MaterialIssue[]
  createdLabours             Labour[]
  createdLabourAttendances   LabourAttendance[]
  createdLabourAdvances      LabourAdvance[]
  createdLabourPayments      LabourPayment[]
  dprsAsEngineer             DailyProgressReport[] @relation("DPREngineer")
  dprsCreated                DailyProgressReport[] @relation("DPRCreatedBy")
  dprEmailsSent              DPREmailLog[]         @relation("DPREmailSentBy")
  mbsAsEngineer              MeasurementBook[]     @relation("MBEngineer")
  mbsCreated                 MeasurementBook[]     @relation("MBCreatedBy")
  mbEmailsSent               MBEmailLog[]          @relation("MBEmailSentBy")
  runningBillsCreated        RunningBill[]         @relation("RunningBillCreatedBy")
  tenderPercentChangesLogged SiteTenderPercentChangeLog[]
  workOrderExtensionsCreated WorkOrderExtension[]
  runningBillPaymentsCreated RunningBillPayment[]  @relation("RunningBillPaymentCreatedBy")
  runningBillEmailsSent      RunningBillEmailLog[] @relation("RunningBillEmailSentBy")
  bankTransactionsCreated    BankTransaction[]     @relation("BankTransactionCreatedBy")
  bankStatementImportsCreated BankStatementImport[] @relation("BankStatementImportCreatedBy")
  bankStatementAuditLogsPerformed BankStatementAuditLog[] @relation("BankStatementAuditPerformedBy")
  siteBillItemsCreated       SiteBillItem[]        @relation("SiteBillItemCreatedBy")
  transactionAllocationsCreated TransactionAllocation[]
  partnerInvestmentsCreated  PartnerInvestment[]
  partnerSettlementsCreated  PartnerSettlement[]
  siteRecapRevisionsCreated  SiteRecapRevision[]
  siteVisitsCreated          SiteVisit[]
  liabilityRepaymentsCreated LiabilityRepayment[]
  measurementItemFieldAuditsChanged MeasurementItemFieldAudit[]
}

model Client {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  name          String
  // System-generated, permanent, read-only — CLI/<FY>/<Seq>.
  clientCode    String?
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  city          String?
  state         String?
  pincode       String?
  website       String?
  gstNumber     String?
  panNumber     String?
  status        String   @default("Active")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  projects  Project[]
  documents Document[]

  @@unique([companyId, clientCode])
  @@index([companyId])
  @@index([status])
}

model ProjectType {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

