generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  ACCOUNTANT
  ENGINEER
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum SubWorkStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum SiteType {
  OWN_SITE
  PARTNERSHIP_SITE
  AGENCY_SITE
}

enum SiteVisitStatus {
  PLANNED
  COMPLETED
  CANCELLED
}

enum Shift {
  DAY
  NIGHT
}

enum VisitorType {
  EXECUTIVE_ENGINEER
  DEPUTY_ENGINEER
  ASSISTANT_ENGINEER
  JUNIOR_ENGINEER
  CONSULTANT
  CLIENT
  OTHER
}

enum SiteProblemType {
  RAIN
  LABOUR_SHORTAGE
  MATERIAL_SHORTAGE
  MACHINERY_BREAKDOWN
  DRAWING_PENDING
  OTHER
}

enum ProcurementStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
}

enum ReceiptStatus {
  PENDING
  IN_TRANSIT
  RECEIVED
  PARTIALLY_RECEIVED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  FAILED
}

enum DocumentType {
  CONTRACT
  DRAWING
  INVOICE
  PHOTO
  REPORT
  OTHER
  PROGRESS_PHOTO
  SITE_PHOTO
  SCANNED_MB
  ABSTRACT_SHEET
  TEST_REPORT
  GOVERNMENT_LETTER
  WORK_ORDER
  AGREEMENT
  BOQ
  TECHNICAL_SANCTION
  ADMINISTRATIVE_APPROVAL
}

/**
 * SUPERVISOR and OPERATOR were added for DPR's Labour Summary breakdown — see DailyProgressReport.
 */
enum LabourCategory {
  SKILLED
  SEMI_SKILLED
  UNSKILLED
  SUPERVISOR
  OPERATOR
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
}

enum EquipmentStatus {
  RUNNING
  IDLE
  BREAKDOWN
  MAINTENANCE
  DECOMMISSIONED
}

/**
 * DRAFT/SUBMITTED are manually set by the engineer. PASSED is a manual certification action
 * (must be SUBMITTED first). PARTLY_PAID/FULLY_PAID are never set directly — they're derived
 * automatically from amountReceived vs netPayable the moment a payment is recorded against a
 * PASSED bill (see deriveRunningBillStatus in running-bill.service.ts).
 */
enum BillStatus {
  DRAFT
  SUBMITTED
  PASSED
  PARTLY_PAID
  FULLY_PAID
}

enum BillType {
  RA_BILL
  FINAL_BILL
  ADVANCE_BILL
}

enum DeductionType {
  SECURITY_DEPOSIT
  GST
  LABOUR_CESS
  ROYALTY
  TDS
  MOBILIZATION_RECOVERY
  OTHER
}

enum MeasurementBookStatus {
  DRAFT
  SUBMITTED
  APPROVED
}

enum InventoryStatus {
  HEALTHY
  LOW
  CRITICAL
  OUT_OF_STOCK
}

enum StockMovementType {
  OPENING
  RECEIPT
  ISSUE
  ADJUSTMENT
}

enum VendorBillStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum BankAccountType {
  BANK
  CASH
}

/**
 * UNALLOCATED: no TransactionAllocation rows yet. FULLY_ALLOCATED: allocations sum to the
 * transaction's full amount. PARTIALLY_ALLOCATED: some but not all of the amount has a
 * declared purpose yet — flagged for follow-up, never silently treated as fully allocated.
 */
enum AllocationStatus {
  UNALLOCATED
  PARTIALLY_ALLOCATED
  FULLY_ALLOCATED
}

enum BankTransactionSource {
  MANUAL
  IMPORTED
}

/**
 * The 11 purposes a bank Deposit/Withdrawal can be allocated to. RUNNING_BILL_RECEIPT/
 * VENDOR_PAYMENT/LABOUR/SITE_EXPENSE each auto-create their real ledger row (RunningBillPayment/
 * VendorPayment/LabourPayment/Expense) — see TransactionAllocation. The remaining 7 types have
 * no dedicated ledger yet (Partnership/Loan/GST/Office books are a future phase), so the
 * allocation row itself IS the ledger entry for those.
 */
enum AllocationType {
  RUNNING_BILL_RECEIPT
  VENDOR_PAYMENT
  LABOUR
  SITE_EXPENSE
  INTERNAL_TRANSFER
  OWNER_INVESTMENT
  PARTNER_INVESTMENT
  GST
  LOAN
  OFFICE_EXPENSE
  OTHER
}

model Company {
  id        String   @id @default(cuid())
  name      String
  gstNumber String?
  panNumber String?
  email     String?
  phone     String?
  address   String?
  city      String?
  state     String?
  country   String?
  pincode   String?
  logo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                 User[]
  roles                 Role[]
  clients               Client[]
  projectTypes          ProjectType[]
  projects              Project[]
  vendors               Vendor[]
  purchaseRequisitions  PurchaseRequisition[]
  purchaseOrders        PurchaseOrder[]
  materialReceipts      MaterialReceipt[]
  inventoryEntries      Inventory[]
  materialIssues        MaterialIssue[]
  stockLedgerEntries    StockLedgerEntry[]
  labours               Labour[]
  equipments            Equipment[]
  runningBills          RunningBill[]
  measurementBooks      MeasurementBook[]
  expenses              Expense[]
  payments              Payment[]
  documents             Document[]
  vendorBills           VendorBill[]
  vendorBankAccounts    VendorBankAccount[]
  bankAccounts          CompanyBankAccount[]
  vendorPayments        VendorPayment[]
  expenseCategories     ExpenseCategory[]
  labourGroups          LabourGroup[]
  labourWageRates       LabourWageRate[]
  labourAttendances     LabourAttendance[]
  labourAdvances        LabourAdvance[]
  labourPayments        LabourPayment[]
  subWorks              SubWork[]
  dailyProgressReports  DailyProgressReport[]
  dprVisitors           DPRVisitor[]
  dprSiteProblems       DPRSiteProblem[]
  dprEmailLogs          DPREmailLog[]
  measurementBookItems  MeasurementBookItem[]
  mbEmailLogs           MBEmailLog[]
  runningBillItems      RunningBillItem[]
  runningBillDeductions RunningBillDeduction[]
  runningBillPayments   RunningBillPayment[]
  runningBillEmailLogs  RunningBillEmailLog[]
  bankTransactions      BankTransaction[]
  transactionAllocations TransactionAllocation[]
  projectContractInfos  ProjectContractInfo[]
  sites                 Site[]
  siteRecapRevisions    SiteRecapRevision[]
  siteVisits            SiteVisit[]
}

model CompanyBankAccount {
  id              String          @id @default(cuid())
  companyId       String
  company         Company         @relation(fields: [companyId], references: [id])
  nickname        String?
  beneficiaryName String?
  bankName        String
  accountNumber   String
  ifscCode        String
  branch          String?
  upiId           String?
  // BANK is a real bank account; CASH represents "Cash in Hand". accountType is orthogonal to
  // isPrimary/isActive ("Account Status") which already existed. Current Balance is never
  // stored — it's always openingBalance + sum(BankTransaction.deposit) - sum(withdrawal),
  // computed on demand in bank-transaction.service.ts, mirroring the "never store a derivable
  // total" convention used by SubWork's budget/actual-cost fields.
  accountType     BankAccountType @default(BANK)
  openingBalance  Decimal         @default(0) @db.Decimal(14, 2)
  isPrimary       Boolean         @default(false)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  vendorPayments      VendorPayment[]
  expenses            Expense[]
  labourAdvances      LabourAdvance[]
  labourPayments      LabourPayment[]
  runningBillPayments RunningBillPayment[]
  bankTransactions    BankTransaction[]

  @@index([companyId])
}

model Role {
  id        String   @id @default(cuid())
  name      UserRole
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, companyId])
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  active    Boolean  @default(true)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdExpenses            Expense[]
  createdMaterialIssues      MaterialIssue[]
  createdLabours             Labour[]
  createdLabourAttendances   LabourAttendance[]
  createdLabourAdvances      LabourAdvance[]
  createdLabourPayments      LabourPayment[]
  dprsAsEngineer             DailyProgressReport[] @relation("DPREngineer")
  dprsCreated                DailyProgressReport[] @relation("DPRCreatedBy")
  dprEmailsSent              DPREmailLog[]         @relation("DPREmailSentBy")
  mbsAsEngineer              MeasurementBook[]     @relation("MBEngineer")
  mbsCreated                 MeasurementBook[]     @relation("MBCreatedBy")
  mbEmailsSent               MBEmailLog[]          @relation("MBEmailSentBy")
  runningBillsCreated        RunningBill[]         @relation("RunningBillCreatedBy")
  runningBillPaymentsCreated RunningBillPayment[]  @relation("RunningBillPaymentCreatedBy")
  runningBillEmailsSent      RunningBillEmailLog[] @relation("RunningBillEmailSentBy")
  bankTransactionsCreated    BankTransaction[]     @relation("BankTransactionCreatedBy")
  transactionAllocationsCreated TransactionAllocation[]
  siteRecapRevisionsCreated  SiteRecapRevision[]
  siteVisitsCreated          SiteVisit[]
}

model Client {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  name          String
  clientCode    String?
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  city          String?
  state         String?
  pincode       String?
  website       String?
  gstNumber     String?
  panNumber     String?
  status        String   @default("Active")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  projects  Project[]
  documents Document[]

  @@index([companyId])
  @@index([status])
}

model ProjectType {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projects Project[]
}

model Project {
  id            String        @id @default(cuid())
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id])
  clientId      String?
  client        Client?       @relation(fields: [clientId], references: [id])
  projectTypeId String?
  projectType   ProjectType?  @relation(fields: [projectTypeId], references: [id])
  name          String
  code          String?
  description   String?
  location      String?
  manager       String?
  status        ProjectStatus @default(PLANNING)
  contractValue Decimal       @default(0) @db.Decimal(12, 2)
  progress      Int           @default(0)
  startDate     DateTime?
  endDate       DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  purchaseRequisitions PurchaseRequisition[]
  purchaseOrders       PurchaseOrder[]
  materialReceipts     MaterialReceipt[]
  inventoryEntries     Inventory[]
  materialIssues       MaterialIssue[]
  stockLedgerEntries   StockLedgerEntry[]
  labours              Labour[]
  equipments           Equipment[]
  runningBills         RunningBill[]
  measurementBooks     MeasurementBook[]
  expenses             Expense[]
  payments             Payment[]
  documents            Document[]
  vendorBills          VendorBill[]
  vendorPayments       VendorPayment[]
  labourGroups         LabourGroup[]
  labourAttendances    LabourAttendance[]
  labourAdvances       LabourAdvance[]
  labourPayments       LabourPayment[]
  subWorks             SubWork[]
  dailyProgressReports DailyProgressReport[]
  runningBillPayments  RunningBillPayment[]
  bankTransactions     BankTransaction[]
  contractInfo         ProjectContractInfo?
  sites                Site[]
}

/**
 * Site — the operational unit inside a Project (Project → Sites → Site Workspace).
 * A Project can have multiple physical work sites (e.g. separate work orders/villages
 * under one client contract); every day-to-day operational record (Sub Work, DPR,
 * Measurement Book, Running Bill, Expense, Labour Attendance) is scoped to a Site, not
 * directly to the Project. Contract/statutory figures below are entered once per Site
 * (mirrors ProjectContractInfo's role at the Project level, but these are the values the
 * Site Workspace Overview tab actually displays and edits).
 */
model Site {
  id                   String        @id @default(cuid())
  companyId            String
  company              Company       @relation(fields: [companyId], references: [id])
  projectId            String
  project              Project       @relation(fields: [projectId], references: [id])
  name                 String
  village              String?
  taluka               String?
  district             String?
  engineer             String?
  siteType             SiteType      @default(OWN_SITE)
  status               ProjectStatus @default(PLANNING)
  contractValue        Decimal       @default(0) @db.Decimal(14, 2)
  emdValue             Decimal       @default(0) @db.Decimal(14, 2)
  securityDeposit      Decimal       @default(0) @db.Decimal(14, 2)
  performanceGuarantee Decimal       @default(0) @db.Decimal(14, 2)
  workOrderDate        DateTime?
  completionDate       DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  subWorks             SubWork[]
  dailyProgressReports DailyProgressReport[]
  measurementBooks     MeasurementBook[]
  runningBills         RunningBill[]
  expenses             Expense[]
  labourAttendances    LabourAttendance[]
  documents            Document[]
  recapRevisions       SiteRecapRevision[]
  siteVisits           SiteVisit[]
  transactionAllocations TransactionAllocation[]

  @@index([companyId])
  @@index([projectId])
  @@index([status])
}

/**
 * Recapitulation Sheet snapshots for a Site — unlimited revisions, exactly one marked
 * Current at a time. A new revision is always INSERTed, never UPDATEd over a prior one
 * (createSiteRecapRevision wraps the insert + "flip previous current off" in a
 * transaction). `snapshot` freezes the full recap payload (budget/actual/variance per
 * cost head, per Sub Work) as it existed at save time, so historical revisions stay
 * accurate even as later transactions change the live numbers.
 */
model SiteRecapRevision {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  siteId      String
  site        Site     @relation(fields: [siteId], references: [id])
  revisionNo  Int
  isCurrent   Boolean  @default(true)
  label       String?
  notes       String?
  snapshot    Json
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@unique([siteId, revisionNo])
  @@index([companyId])
  @@index([siteId])
  @@index([isCurrent])
}

/**
 * Site Visit Register — one row per planned/completed visit. Planned/Completed/Pending
 * counts on the Site Visits tab are always derived by counting `status`, never stored
 * separately (same "never duplicate a derived total" rule used everywhere else).
 */
model SiteVisit {
  id          String          @id @default(cuid())
  companyId   String
  company     Company         @relation(fields: [companyId], references: [id])
  siteId      String
  site        Site            @relation(fields: [siteId], references: [id])
  visitDate   DateTime        @default(now())
  visitedBy   String?
  purpose     String?
  remarks     String?
  photos      Json?
  status      SiteVisitStatus @default(PLANNED)
  createdById String
  createdBy   User            @relation(fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([companyId])
  @@index([siteId])
  @@index([status])
  @@index([visitDate])
}

/**
 * The master contract record for a Project — Work Order / Agreement / Tender references,
 * the government department hierarchy, and the statutory percentages (Security Deposit,
 * Performance Guarantee, GST). Deliberately a separate 1:1 table rather than more columns on
 * Project: these fields are specific to the new "Contract Information" tab and mostly apply
 * only to government/PWD-style contracts, so keeping them off the base Project row matches the
 * existing convention of isolating tab-specific data (e.g. SubWork's budget fields). Contract
 * Value itself is NOT duplicated here — it stays solely on Project.contractValue and is
 * read/written through it, per the "one source of truth" rule used everywhere else in this app.
 */
model ProjectContractInfo {
  id                          String    @id @default(cuid())
  companyId                   String
  company                     Company   @relation(fields: [companyId], references: [id])
  projectId                   String    @unique
  project                     Project   @relation(fields: [projectId], references: [id])
  workOrderNumber             String?
  workOrderDate               DateTime?
  agreementNumber             String?
  agreementDate               DateTime?
  tenderNumber                String?
  department                  String?
  division                    String?
  subDivision                 String?
  clientEngineer              String?
  estimateAmount              Decimal?  @db.Decimal(14, 2)
  workStartDate               DateTime?
  completionDate              DateTime?
  defectLiabilityPeriod       String?
  securityDepositPercent      Decimal?  @db.Decimal(5, 2)
  performanceGuaranteePercent Decimal?  @db.Decimal(5, 2)
  gstPercent                  Decimal?  @db.Decimal(5, 2)
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([companyId])
}

/**
 * A project's own breakdown of work (e.g. "Foundation", "Superstructure", "Plumbing") —
 * never hardcoded, since every project defines its own set. Each Sub Work carries its
 * own budget; actual cost is never stored here — it's always computed on demand from
 * the existing cost-bearing modules (Expense, VendorBill, LabourAttendance, MaterialIssue)
 * tagged with this subWorkId, via project-control-center.service.ts. This avoids a second,
 * duplicate ledger of financial data.
 */
model SubWork {
  id                 String        @id @default(cuid())
  companyId          String
  company            Company       @relation(fields: [companyId], references: [id])
  projectId          String
  project            Project       @relation(fields: [projectId], references: [id])
  siteId             String
  site               Site          @relation(fields: [siteId], references: [id])
  name               String
  startDate          DateTime?
  endDate            DateTime?
  status             SubWorkStatus @default(PLANNED)
  remarks            String?
  sortOrder          Int           @default(0)
  // Planned budget, broken down by cost head — entered by the engineer/PM. The total budget
  // is NEVER stored; it is always computed on demand as the sum of these 7 fields, in both
  // sub-work.service.ts (SubWork DTO) and project-control-center.service.ts. Mirrors the
  // existing rule that Actual Cost is never stored either — both totals are always derived.
  budgetMaterial     Decimal       @default(0) @db.Decimal(14, 2)
  budgetLabour       Decimal       @default(0) @db.Decimal(14, 2)
  budgetMachinery    Decimal       @default(0) @db.Decimal(14, 2)
  budgetFuel         Decimal       @default(0) @db.Decimal(14, 2)
  budgetSiteExpenses Decimal       @default(0) @db.Decimal(14, 2)
  budgetVendorBills  Decimal       @default(0) @db.Decimal(14, 2)
  budgetOther        Decimal       @default(0) @db.Decimal(14, 2)
  // Physical Progress is entered manually by the engineer — it is NEVER derived from cost.
  // Financial Progress (Actual Cost / Budget) is always computed on demand in
  // project-control-center.service.ts and intentionally not stored here.
  physicalProgress   Int           @default(0)
  progressUpdatedAt  DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  materialIssues       MaterialIssue[]
  expenses             Expense[]
  vendorBills          VendorBill[]
  labourAttendances    LabourAttendance[]
  dailyProgressReports DailyProgressReport[]
  measurementBooks     MeasurementBook[]
  runningBills         RunningBill[]

  @@index([companyId])
  @@index([projectId])
  @@index([siteId])
  @@index([status])
}

/**
 * Daily Progress Report — the official daily site diary. Deliberately stores almost nothing
 * that already lives elsewhere: Labour/Machinery/Material figures are pulled live from
 * LabourAttendance/Expense/MaterialReceipt/MaterialIssue at read time (see dpr.service.ts).
 * The 4 labour-count fields and manualMachineryEntries below are the ONLY sanctioned
 * exceptions — they hold an editable snapshot (auto-filled from live data, then optionally
 * hand-adjusted by the engineer), never a second source of truth.
 */
model DailyProgressReport {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id])
  siteId       String
  siteRecord   Site     @relation(fields: [siteId], references: [id])
  subWorkId    String?
  subWork      SubWork? @relation(fields: [subWorkId], references: [id])
  dprNumber    String   @unique
  reportDate   DateTime @default(now())
  site         String?
  engineerId   String?
  engineer     User?    @relation("DPREngineer", fields: [engineerId], references: [id])
  contractorId String?
  contractor   Vendor?  @relation(fields: [contractorId], references: [id])
  weather      String?
  shift        Shift    @default(DAY)
  remarks      String?

  // Work Progress
  workDone               String?
  plannedWork            String?
  physicalProgressUpdate Int?
  delayReason            String?
  instructions           String?

  // Labour Summary — auto-filled from LabourAttendance at creation time, editable thereafter.
  // Total Labour is intentionally never stored — always the sum of these 4, computed in dpr.service.ts.
  labourSkilled          Int     @default(0)
  labourUnskilled        Int     @default(0)
  labourSupervisor       Int     @default(0)
  labourOperator         Int     @default(0)
  labourManuallyAdjusted Boolean @default(false)

  // Machinery Summary is normally pulled live from Expense (category "Machinery") for this
  // date/project — these manual entries exist only for machines used but not yet logged as
  // a Site Expense, so the DPR isn't blocked waiting on bookkeeping.
  manualMachineryEntries Json?

  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdById String
  createdBy   User      @relation("DPRCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  visitors     DPRVisitor[]
  siteProblems DPRSiteProblem[]
  documents    Document[]
  emailLogs    DPREmailLog[]

  @@unique([companyId, projectId, reportDate, shift])
  @@index([companyId])
  @@index([projectId])
  @@index([siteId])
  @@index([subWorkId])
  @@index([reportDate])
  @@index([isDeleted])
}

model DPRVisitor {
  id          String              @id @default(cuid())
  companyId   String
  company     Company             @relation(fields: [companyId], references: [id])
  dprId       String
  dpr         DailyProgressReport @relation(fields: [dprId], references: [id])
  visitorType VisitorType
  name        String?
  remarks     String?
  createdAt   DateTime            @default(now())

  @@index([companyId])
  @@index([dprId])
}

model DPRSiteProblem {
  id          String              @id @default(cuid())
  companyId   String
  company     Company             @relation(fields: [companyId], references: [id])
  dprId       String
  dpr         DailyProgressReport @relation(fields: [dprId], references: [id])
  problemType SiteProblemType
  description String?
  createdAt   DateTime            @default(now())

  @@index([companyId])
  @@index([dprId])
}

/**
 * Audit log of DPR emails sent — recipients/attachments actually delivered, for traceability.
 */
model DPREmailLog {
  id            String              @id @default(cuid())
  companyId     String
  company       Company             @relation(fields: [companyId], references: [id])
  dprId         String
  dpr           DailyProgressReport @relation(fields: [dprId], references: [id])
  recipients    Json
  includedExcel Boolean             @default(false)
  sentById      String
  sentBy        User                @relation("DPREmailSentBy", fields: [sentById], references: [id])
  sentAt        DateTime            @default(now())
  status        String              @default("SENT")
  errorMessage  String?

  @@index([companyId])
  @@index([dprId])
}

/**
 * Audit log of Measurement Book emails sent — recipients/attachments actually delivered, for traceability.
 */
model MBEmailLog {
  id                String          @id @default(cuid())
  companyId         String
  company           Company         @relation(fields: [companyId], references: [id])
  measurementBookId String
  measurementBook   MeasurementBook @relation(fields: [measurementBookId], references: [id])
  recipients        Json
  includedExcel     Boolean         @default(false)
  sentById          String
  sentBy            User            @relation("MBEmailSentBy", fields: [sentById], references: [id])
  sentAt            DateTime        @default(now())
  status            String          @default("SENT")
  errorMessage      String?

  @@index([companyId])
  @@index([measurementBookId])
}

model Vendor {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  name          String
  vendorCode    String?
  category      String?
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  city          String?
  state         String?
  pincode       String?
  gstNumber     String?
  panNumber     String?
  notes         String?
  status        String   @default("Active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  purchaseOrders       PurchaseOrder[]
  purchaseRequisitions PurchaseRequisition[]
  expenses             Expense[]
