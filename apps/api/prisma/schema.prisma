generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  ACCOUNTANT
  ENGINEER
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProcurementStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
}

enum ReceiptStatus {
  PENDING
  IN_TRANSIT
  RECEIVED
  PARTIALLY_RECEIVED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  FAILED
}

enum DocumentType {
  CONTRACT
  DRAWING
  INVOICE
  PHOTO
  REPORT
  OTHER
}

enum ExpenseType {
  MATERIAL
  LABOUR
  EQUIPMENT
  OVERHEAD
  OTHER
}

enum LabourCategory {
  SKILLED
  SEMI_SKILLED
  UNSKILLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
}

enum EquipmentStatus {
  RUNNING
  IDLE
  BREAKDOWN
  MAINTENANCE
  DECOMMISSIONED
}

enum BillStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PAID
  CANCELLED
}

enum BillType {
  RA_BILL
  FINAL_BILL
  ADVANCE_BILL
}

enum MeasurementStatus {
  DRAFT
  VERIFIED
  APPROVED
  REVISED
}

enum InventoryStatus {
  HEALTHY
  LOW
  CRITICAL
  OUT_OF_STOCK
}

enum StockMovementType {
  OPENING
  RECEIPT
  ISSUE
  ADJUSTMENT
}

enum VendorBillStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  CANCELLED
}

model Company {
  id        String   @id @default(cuid())
  name      String
  gstNumber String?
  panNumber String?
  email     String?
  phone     String?
  address   String?
  city      String?
  state     String?
  country   String?
  pincode   String?
  logo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                User[]
  roles                Role[]
  clients              Client[]
  projectTypes         ProjectType[]
  projects             Project[]
  vendors              Vendor[]
  purchaseRequisitions PurchaseRequisition[]
  purchaseOrders       PurchaseOrder[]
  materialReceipts     MaterialReceipt[]
  inventoryEntries     Inventory[]
  materialIssues       MaterialIssue[]
  stockLedgerEntries   StockLedgerEntry[]
  labours              Labour[]
  equipments           Equipment[]
  runningBills         RunningBill[]
  measurementBooks     MeasurementBook[]
  expenses             Expense[]
  payments             Payment[]
  documents            Document[]
  vendorBills          VendorBill[]
  vendorBankAccounts   VendorBankAccount[]
  bankAccounts         CompanyBankAccount[]
  vendorPayments       VendorPayment[]
}

model CompanyBankAccount {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  nickname        String?
  beneficiaryName String?
  bankName        String
  accountNumber   String
  ifscCode        String
  branch          String?
  upiId           String?
  isPrimary       Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vendorPayments VendorPayment[]

  @@index([companyId])
}

model Role {
  id        String   @id @default(cuid())
  name      UserRole
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, companyId])
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  active    Boolean  @default(true)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Client {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  name          String
  clientCode    String?
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  city          String?
  state         String?
  pincode       String?
  website       String?
  gstNumber     String?
  panNumber     String?
  status        String   @default("Active")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  projects  Project[]
  documents Document[]

  @@index([companyId])
  @@index([status])
}

model ProjectType {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projects Project[]
}

model Project {
  id            String        @id @default(cuid())
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id])
  clientId      String?
  client        Client?       @relation(fields: [clientId], references: [id])
  projectTypeId String?
  projectType   ProjectType?  @relation(fields: [projectTypeId], references: [id])
  name          String
  code          String?
  description   String?
  location      String?
  manager       String?
  status        ProjectStatus @default(PLANNING)
  contractValue Decimal       @default(0) @db.Decimal(12, 2)
  progress      Int           @default(0)
  startDate     DateTime?
  endDate       DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  purchaseRequisitions PurchaseRequisition[]
  purchaseOrders       PurchaseOrder[]
  materialReceipts     MaterialReceipt[]
  inventoryEntries     Inventory[]
  materialIssues       MaterialIssue[]
  stockLedgerEntries   StockLedgerEntry[]
  labours              Labour[]
  equipments           Equipment[]
  runningBills         RunningBill[]
  measurementBooks     MeasurementBook[]
  expenses             Expense[]
  payments             Payment[]
  documents            Document[]
  vendorBills          VendorBill[]
  vendorPayments       VendorPayment[]
}

model Vendor {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  name          String
  vendorCode    String?
  category      String?
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  city          String?
  state         String?
  pincode       String?
  gstNumber     String?
  panNumber     String?
  notes         String?
  status        String   @default("Active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  purchaseOrders       PurchaseOrder[]
  purchaseRequisitions PurchaseRequisition[]
  expenses             Expense[]
  payments             Payment[]
  documents            Document[]
  materialReceipts     MaterialReceipt[]
  inventoryItems       Inventory[]
  vendorBills          VendorBill[]
  bankAccounts         VendorBankAccount[]
  vendorPayments       VendorPayment[]

  @@index([companyId])
  @@index([status])
  @@index([category])
}

model VendorBankAccount {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  vendorId        String
  vendor          Vendor   @relation(fields: [vendorId], references: [id])
  nickname        String?
  beneficiaryName String?
  bankName        String
  accountNumber   String
  ifscCode        String
  branch          String?
  upiId           String?
  isPrimary       Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vendorPayments VendorPayment[]

  @@index([companyId])
  @@index([vendorId])
}

model PurchaseRequisition {
  id                String            @id @default(cuid())
  companyId         String
  company           Company           @relation(fields: [companyId], references: [id])
  projectId         String?
  project           Project?          @relation(fields: [projectId], references: [id])
  vendorId          String?
  vendor            Vendor?           @relation(fields: [vendorId], references: [id])
  requisitionNumber String            @unique
  title             String
  description       String?
  items             Json?
  requiredDate      DateTime?
  status            ProcurementStatus @default(DRAFT)
  totalAmount       Decimal           @default(0) @db.Decimal(12, 2)
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  purchaseOrders PurchaseOrder[]
  documents      Document[]

  @@index([companyId])
  @@index([projectId])
  @@index([status])
}

model PurchaseOrder {
  id              String               @id @default(cuid())
  companyId       String
  company         Company              @relation(fields: [companyId], references: [id])
  projectId       String?
  project         Project?             @relation(fields: [projectId], references: [id])
  vendorId        String?
  vendor          Vendor?              @relation(fields: [vendorId], references: [id])
  requisitionId   String?
  requisition     PurchaseRequisition? @relation(fields: [requisitionId], references: [id])
  poNumber        String               @unique
  orderDate       DateTime             @default(now())
  expectedDate    DateTime?
  deliveryAddress String?
  paymentTerms    String?
  items           Json?
  discount        Decimal              @default(0) @db.Decimal(12, 2)
  gstAmount       Decimal              @default(0) @db.Decimal(12, 2)
  amount          Decimal              @default(0) @db.Decimal(12, 2)
  status          ProcurementStatus    @default(DRAFT)
  notes           String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  materialReceipts MaterialReceipt[]
  payments         Payment[]
  documents        Document[]
  vendorBills      VendorBill[]

  @@index([companyId])
  @@index([projectId])
  @@index([status])
  @@index([requisitionId])
}

model MaterialReceipt {
  id                     String         @id @default(cuid())
  companyId              String
  company                Company        @relation(fields: [companyId], references: [id])
  projectId              String?
  project                Project?       @relation(fields: [projectId], references: [id])
  purchaseOrderId        String?
  purchaseOrder          PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  vendorId               String?
  vendor                 Vendor?        @relation(fields: [vendorId], references: [id])
  inventoryId            String?
  inventory              Inventory?     @relation(fields: [inventoryId], references: [id])
  receiptNumber          String         @unique
  receivedDate           DateTime       @default(now())
  challanNumber          String?
  supplierInvoiceNumber  String?
  vehicleNumber          String?
  receivedBy             String?
  supplierRepresentative String?
  items                  Json?
  itemName               String
  quantity               Decimal        @default(0) @db.Decimal(12, 2)
  unit                   String?
  qualityStatus          String?
  status                 ReceiptStatus  @default(PENDING)
  remarks                String?
  notes                  String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  documents   Document[]
  vendorBills VendorBill[]

  @@index([companyId])
  @@index([purchaseOrderId])
  @@index([projectId])
  @@index([status])
}

model Inventory {
  id               String          @id @default(cuid())
  companyId        String
  company          Company         @relation(fields: [companyId], references: [id])
  projectId        String?
  project          Project?        @relation(fields: [projectId], references: [id])
  itemCode         String?
  itemName         String
  category         String?
  unit             String?
  openingBalance   Decimal         @default(0) @db.Decimal(12, 2)
  receiptsQuantity Decimal         @default(0) @db.Decimal(12, 2)
  issuesQuantity   Decimal         @default(0) @db.Decimal(12, 2)
  currentStock     Decimal         @default(0) @db.Decimal(12, 2)
  reservedStock    Decimal         @default(0) @db.Decimal(12, 2)
  reorderLevel     Decimal         @default(0) @db.Decimal(12, 2)
  minStock         Decimal         @default(0) @db.Decimal(12, 2)
  maxStock         Decimal         @default(0) @db.Decimal(12, 2)
  warehouse        String?
  rackLocation     String?
  batchNumber      String?
  supplierId       String?
  supplier         Vendor?         @relation(fields: [supplierId], references: [id])
  lastReceiptDate  DateTime?
  lastIssueDate    DateTime?
  location         String?
  status           InventoryStatus @default(HEALTHY)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  materialReceipts   MaterialReceipt[]
  materialIssues     MaterialIssue[]
  stockLedgerEntries StockLedgerEntry[]

  @@index([companyId])
  @@index([projectId])
  @@index([status])
  @@index([category])
  @@index([itemCode])
  @@index([warehouse])
  @@index([supplierId])
}

model StockLedgerEntry {
  id              String            @id @default(cuid())
  companyId       String
  company         Company           @relation(fields: [companyId], references: [id])
  inventoryId     String
  inventory       Inventory         @relation(fields: [inventoryId], references: [id])
  projectId       String?
  project         Project?          @relation(fields: [projectId], references: [id])
  movementType    StockMovementType
  quantity        Decimal           @db.Decimal(12, 2)
  balanceAfter    Decimal           @db.Decimal(12, 2)
  referenceType   String?
  referenceId     String?
  referenceNumber String?
  remarks         String?
  movementDate    DateTime          @default(now())
  createdAt       DateTime          @default(now())

  @@index([companyId])
  @@index([inventoryId])
  @@index([movementType])
  @@index([movementDate])
}

model MaterialIssue {
  id          String            @id @default(cuid())
  companyId   String
  company     Company           @relation(fields: [companyId], references: [id])
  projectId   String?
  project     Project?          @relation(fields: [projectId], references: [id])
  inventoryId String?
  inventory   Inventory?        @relation(fields: [inventoryId], references: [id])
  issueNumber String            @unique
  issuedDate  DateTime          @default(now())
  itemName    String
  quantity    Decimal           @default(0) @db.Decimal(12, 2)
  unit        String?
  issuedTo    String?
  issuedBy    String?
  status      ProcurementStatus @default(APPROVED)
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model Labour {
  id               String           @id @default(cuid())
  companyId        String
  company          Company          @relation(fields: [companyId], references: [id])
  projectId        String?
  project          Project?         @relation(fields: [projectId], references: [id])
  name             String
  contractorName   String?
  designation      String?
  category         LabourCategory   @default(UNSKILLED)
  shift            String?
  dailyWage        Decimal?         @db.Decimal(12, 2)
  overtimeRate     Decimal?         @db.Decimal(12, 2)
  attendanceStatus AttendanceStatus @default(PRESENT)
  status           String           @default("Active")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([companyId])
  @@index([projectId])
  @@index([category])
  @@index([attendanceStatus])
}

model Equipment {
  id                  String          @id @default(cuid())
  companyId           String
  company             Company         @relation(fields: [companyId], references: [id])
  projectId           String?
  project             Project?        @relation(fields: [projectId], references: [id])
  assetNumber         String?
  assetName           String
  equipmentType       String
  registrationNumber  String?
  operatorName        String?
  fuelConsumption     Decimal?        @db.Decimal(12, 2)
  runningHours        Decimal?        @db.Decimal(10, 2)
  maintenanceSchedule String?
  maintenanceDue      DateTime?
  breakdownNotes      String?
  currentSite         String?
  status              EquipmentStatus @default(RUNNING)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([companyId])
  @@index([projectId])
  @@index([status])
}

model MeasurementBook {
  id               String            @id @default(cuid())
  companyId        String
  company          Company           @relation(fields: [companyId], references: [id])
  projectId        String?
  project          Project?          @relation(fields: [projectId], references: [id])
  mbNumber         String            @unique
  mbDate           DateTime?
  pageNumber       String?
  boqItem          String?
  itemDescription  String?
  unit             String?
  previousQuantity Decimal           @default(0) @db.Decimal(12, 4)
  currentQuantity  Decimal           @default(0) @db.Decimal(12, 4)
  totalQuantity    Decimal           @default(0) @db.Decimal(12, 4)
  boqRate          Decimal           @default(0) @db.Decimal(14, 2)
  extraItemRate    Decimal           @default(0) @db.Decimal(14, 2)
  previousAmount   Decimal           @default(0) @db.Decimal(14, 2)
  currentAmount    Decimal           @default(0) @db.Decimal(14, 2)
  totalAmount      Decimal           @default(0) @db.Decimal(14, 2)
  measuredBy       String?
  checkedBy        String?
  verifiedBy       String?
  approvedBy       String?
  status           MeasurementStatus @default(DRAFT)
  remarks          String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  runningBills RunningBill[]

  @@index([companyId])
  @@index([projectId])
  @@index([status])
}

model RunningBill {
  id                      String           @id @default(cuid())
  companyId               String
  company                 Company          @relation(fields: [companyId], references: [id])
  projectId               String?
  project                 Project?         @relation(fields: [projectId], references: [id])
  measurementBookId       String?
  measurementBook         MeasurementBook? @relation(fields: [measurementBookId], references: [id])
  billType                BillType         @default(RA_BILL)
  billNumber              String           @unique
  billPeriodFrom          DateTime?
  billPeriodTo            DateTime?
  grossAmount             Decimal          @default(0) @db.Decimal(14, 2)
  previousCertifiedAmount Decimal          @default(0) @db.Decimal(14, 2)
  currentCertifiedAmount  Decimal          @default(0) @db.Decimal(14, 2)
  totalCertifiedAmount    Decimal          @default(0) @db.Decimal(14, 2)
  securityDeposit         Decimal          @default(0) @db.Decimal(14, 2)
  royaltyRecovery         Decimal          @default(0) @db.Decimal(14, 2)
  mobilizationRecovery    Decimal          @default(0) @db.Decimal(14, 2)
  otherRecovery           Decimal          @default(0) @db.Decimal(14, 2)
  gstAmount               Decimal          @default(0) @db.Decimal(14, 2)
  netPayable              Decimal          @default(0) @db.Decimal(14, 2)
  amountReceived          Decimal          @default(0) @db.Decimal(14, 2)
  outstandingAmount       Decimal          @default(0) @db.Decimal(14, 2)
  submissionDate          DateTime?
  approvalDate            DateTime?
  paymentDate             DateTime?
  submittedBy             String?
  checkedBy               String?
  approvedBy              String?
  status                  BillStatus       @default(DRAFT)
  remarks                 String?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  @@index([companyId])
  @@index([projectId])
  @@index([measurementBookId])
  @@index([status])
  @@index([billType])
}

model Expense {
  id            String        @id @default(cuid())
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id])
  projectId     String?
  project       Project?      @relation(fields: [projectId], references: [id])
  vendorId      String?
  vendor        Vendor?       @relation(fields: [vendorId], references: [id])
  expenseNumber String        @unique
  expenseDate   DateTime      @default(now())
  type          ExpenseType   @default(OTHER)
  amount        Decimal       @default(0) @db.Decimal(12, 2)
  status        PaymentStatus @default(PENDING)
  description   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  payments Payment[]
}

model Payment {
  id              String         @id @default(cuid())
  companyId       String
  company         Company        @relation(fields: [companyId], references: [id])
  projectId       String?
  project         Project?       @relation(fields: [projectId], references: [id])
  vendorId        String?
  vendor          Vendor?        @relation(fields: [vendorId], references: [id])
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  expenseId       String?
  expense         Expense?       @relation(fields: [expenseId], references: [id])
  paymentNumber   String         @unique
  paymentDate     DateTime       @default(now())
  amount          Decimal        @default(0) @db.Decimal(12, 2)
  mode            String?
  remarks         String?
  status          PaymentStatus  @default(PENDING)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([companyId])
  @@index([status])
}

/**
 * Vendor Bill — the AP Construction workflow's central payable record.
 * Purchase Order and Material Receipt references are OPTIONAL: this company
 * normally orders materials by phone and bills them directly against the
 * vendor + project once delivered, without ever raising a PO.
 */
model VendorBill {
  id                 String           @id @default(cuid())
  companyId          String
  company            Company          @relation(fields: [companyId], references: [id])
  vendorId           String
  vendor             Vendor           @relation(fields: [vendorId], references: [id])
  projectId          String?
  project            Project?         @relation(fields: [projectId], references: [id])
  purchaseOrderId    String?
  purchaseOrder      PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id])
  materialReceiptId  String?
  materialReceipt    MaterialReceipt? @relation(fields: [materialReceiptId], references: [id])
  billNumber         String           @unique
  billDate           DateTime         @default(now())
  dueDate            DateTime?
  billAmount         Decimal          @default(0) @db.Decimal(12, 2)
  taxableAmount      Decimal          @default(0) @db.Decimal(12, 2)
  gstAmount          Decimal          @default(0) @db.Decimal(12, 2)
  totalAmount        Decimal          @default(0) @db.Decimal(12, 2)
  paidAmount         Decimal          @default(0) @db.Decimal(12, 2)
  outstandingBalance Decimal          @default(0) @db.Decimal(12, 2)
  invoiceFileName    String?
  invoiceFileUrl     String?
  status             VendorBillStatus @default(PENDING)
  notes              String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  payments VendorPayment[]

  @@index([companyId])
  @@index([vendorId])
  @@index([projectId])
  @@index([purchaseOrderId])
  @@index([materialReceiptId])
  @@index([status])
  @@index([dueDate])
}

/**
 * VendorPayment — a dedicated, first-class payment ledger for the Vendor Bill →
 * Vendor Payment workflow. Deliberately not the generic `Payment` model: this
 * keeps the vendor-payables ledger self-contained (bill, and both sides of the
 * bank transfer) rather than mixed into a catch-all table shared with
 * unrelated future concerns (expenses, client receipts, etc.).
 */
model VendorPayment {
  id                   String              @id @default(cuid())
  companyId            String
  company              Company             @relation(fields: [companyId], references: [id])
  vendorId             String
  vendor               Vendor              @relation(fields: [vendorId], references: [id])
  projectId            String?
  project              Project?            @relation(fields: [projectId], references: [id])
  vendorBillId         String
  vendorBill           VendorBill          @relation(fields: [vendorBillId], references: [id])
  companyBankAccountId String?
  companyBankAccount   CompanyBankAccount? @relation(fields: [companyBankAccountId], references: [id])
  vendorBankAccountId  String?
  vendorBankAccount    VendorBankAccount?  @relation(fields: [vendorBankAccountId], references: [id])
  paymentNumber        String              @unique
  paymentDate          DateTime            @default(now())
  amount               Decimal             @db.Decimal(12, 2)
  mode                 String?
  referenceNumber      String?
  attachmentFileName   String?
  attachmentFileUrl    String?
  remarks              String?
  status               PaymentStatus       @default(PAID)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([companyId])
  @@index([vendorId])
  @@index([vendorBillId])
  @@index([companyBankAccountId])
  @@index([vendorBankAccountId])
  @@index([status])
}

model Document {
  id                    String               @id @default(cuid())
  companyId             String
  company               Company              @relation(fields: [companyId], references: [id])
  projectId             String?
  project               Project?             @relation(fields: [projectId], references: [id])
  clientId              String?
  client                Client?              @relation(fields: [clientId], references: [id])
  vendorId              String?
  vendor                Vendor?              @relation(fields: [vendorId], references: [id])
  purchaseOrderId       String?
  purchaseOrder         PurchaseOrder?       @relation(fields: [purchaseOrderId], references: [id])
  purchaseRequisitionId String?
  purchaseRequisition   PurchaseRequisition? @relation(fields: [purchaseRequisitionId], references: [id])
  materialReceiptId     String?
  materialReceipt       MaterialReceipt?     @relation(fields: [materialReceiptId], references: [id])
  documentType          DocumentType         @default(OTHER)
  documentNumber        String               @unique
  fileName              String?
  fileUrl               String?
  notes                 String?
  uploadedAt            DateTime             @default(now())
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
}
