/**
 * Audit log of Measurement Book emails sent — recipients/attachments actually delivered, for traceability.
 */
model MBEmailLog {
  id                String          @id @default(cuid())
  companyId         String
  company           Company         @relation(fields: [companyId], references: [id])
  measurementBookId String
  measurementBook   MeasurementBook @relation(fields: [measurementBookId], references: [id])
  recipients        Json
  includedExcel     Boolean         @default(false)
  sentById          String
  sentBy            User            @relation("MBEmailSentBy", fields: [sentById], references: [id])
  sentAt            DateTime        @default(now())
  status            String          @default("SENT")
  errorMessage      String?

  @@index([companyId])
  @@index([measurementBookId])
}

model Vendor {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  name          String
  // System-generated, permanent, read-only — VEN/<FY>/<Seq>.
  vendorCode    String?
  category      String?
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  city          String?
  state         String?
  pincode       String?
  gstNumber     String?
  panNumber     String?
  notes         String?
  status        String   @default("Active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  purchaseOrders       PurchaseOrder[]
  purchaseRequisitions PurchaseRequisition[]
  expenses             Expense[]
  payments             Payment[]
  documents            Document[]
  materialReceipts     MaterialReceipt[]
  inventoryItems       Inventory[]
  vendorBills          VendorBill[]
  bankAccounts         VendorBankAccount[]
  vendorPayments       VendorPayment[]
  contractedLabour     Labour[]
  dprsAsContractor     DailyProgressReport[]
  mbsAsContractor      MeasurementBook[]

  @@unique([companyId, vendorCode])
  @@index([companyId])
  @@index([status])
  @@index([category])
}

model VendorBankAccount {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  vendorId        String
  vendor          Vendor   @relation(fields: [vendorId], references: [id])
  nickname        String?
  beneficiaryName String?
  bankName        String
  accountNumber   String
  ifscCode        String
  branch          String?
  upiId           String?
  isPrimary       Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vendorPayments VendorPayment[]

  @@index([companyId])
  @@index([vendorId])
}

model PurchaseRequisition {
  id                String            @id @default(cuid())
  companyId         String
  company           Company           @relation(fields: [companyId], references: [id])
  projectId         String?
  project           Project?          @relation(fields: [projectId], references: [id])
  vendorId          String?
  vendor            Vendor?           @relation(fields: [vendorId], references: [id])
  requisitionNumber String            @unique
  title             String
  description       String?
  items             Json?
  requiredDate      DateTime?
  status            ProcurementStatus @default(DRAFT)
  totalAmount       Decimal           @default(0) @db.Decimal(12, 2)
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  purchaseOrders PurchaseOrder[]
  documents      Document[]

  @@index([companyId])
  @@index([projectId])
  @@index([status])
}

model PurchaseOrder {
  id              String               @id @default(cuid())
  companyId       String
  company         Company              @relation(fields: [companyId], references: [id])
  projectId       String?
  project         Project?             @relation(fields: [projectId], references: [id])
  vendorId        String?
  vendor          Vendor?              @relation(fields: [vendorId], references: [id])
  requisitionId   String?
  requisition     PurchaseRequisition? @relation(fields: [requisitionId], references: [id])
  poNumber        String               @unique
  orderDate       DateTime             @default(now())
  expectedDate    DateTime?
  deliveryAddress String?
  paymentTerms    String?
  items           Json?
  discount        Decimal              @default(0) @db.Decimal(12, 2)
  gstAmount       Decimal              @default(0) @db.Decimal(12, 2)
  amount          Decimal              @default(0) @db.Decimal(12, 2)
  status          ProcurementStatus    @default(DRAFT)
  notes           String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  materialReceipts MaterialReceipt[]
  payments         Payment[]
  documents        Document[]
  vendorBills      VendorBill[]

  @@index([companyId])
  @@index([projectId])
  @@index([status])
  @@index([requisitionId])
}

model MaterialReceipt {
  id                     String         @id @default(cuid())
  companyId              String
  company                Company        @relation(fields: [companyId], references: [id])
  projectId              String?
  project                Project?       @relation(fields: [projectId], references: [id])
  purchaseOrderId        String?
  purchaseOrder          PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  vendorId               String?
  vendor                 Vendor?        @relation(fields: [vendorId], references: [id])
  inventoryId            String?
  inventory              Inventory?     @relation(fields: [inventoryId], references: [id])
  receiptNumber          String         @unique
  receivedDate           DateTime       @default(now())
  challanNumber          String?
  supplierInvoiceNumber  String?
  vehicleNumber          String?
  receivedBy             String?
  supplierRepresentative String?
  items                  Json?
  itemName               String
  quantity               Decimal        @default(0) @db.Decimal(12, 2)
  unit                   String?
  qualityStatus          String?
  status                 ReceiptStatus  @default(PENDING)
  remarks                String?
  notes                  String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  documents   Document[]
  vendorBills VendorBill[]

  @@index([companyId])
  @@index([purchaseOrderId])
  @@index([projectId])
  @@index([status])
}

model Inventory {
  id               String          @id @default(cuid())
  companyId        String
  company          Company         @relation(fields: [companyId], references: [id])
  projectId        String?
  project          Project?        @relation(fields: [projectId], references: [id])
  itemCode         String?
  itemName         String
  category         String?
  unit             String?
  openingBalance   Decimal         @default(0) @db.Decimal(12, 2)
  receiptsQuantity Decimal         @default(0) @db.Decimal(12, 2)
  issuesQuantity   Decimal         @default(0) @db.Decimal(12, 2)
  currentStock     Decimal         @default(0) @db.Decimal(12, 2)
  reservedStock    Decimal         @default(0) @db.Decimal(12, 2)
  reorderLevel     Decimal         @default(0) @db.Decimal(12, 2)
  minStock         Decimal         @default(0) @db.Decimal(12, 2)
  maxStock         Decimal         @default(0) @db.Decimal(12, 2)
  warehouse        String?
  rackLocation     String?
  batchNumber      String?
  supplierId       String?
  supplier         Vendor?         @relation(fields: [supplierId], references: [id])
  lastReceiptDate  DateTime?
  lastIssueDate    DateTime?
  location         String?
  status           InventoryStatus @default(HEALTHY)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  materialReceipts   MaterialReceipt[]
  materialIssues     MaterialIssue[]
  stockLedgerEntries StockLedgerEntry[]

  @@index([companyId])
  @@index([projectId])
  @@index([status])
  @@index([category])
  @@index([itemCode])
  @@index([warehouse])
  @@index([supplierId])
}

model StockLedgerEntry {
  id              String            @id @default(cuid())
  companyId       String
  company         Company           @relation(fields: [companyId], references: [id])
  inventoryId     String
  inventory       Inventory         @relation(fields: [inventoryId], references: [id])
  projectId       String?
  project         Project?          @relation(fields: [projectId], references: [id])
  movementType    StockMovementType
  quantity        Decimal           @db.Decimal(12, 2)
  balanceAfter    Decimal           @db.Decimal(12, 2)
  referenceType   String?
  referenceId     String?
  referenceNumber String?
  remarks         String?
  movementDate    DateTime          @default(now())
  createdAt       DateTime          @default(now())

  @@index([companyId])
  @@index([inventoryId])
  @@index([movementType])
  @@index([movementDate])
}

/**
 * Company-scoped, admin-manageable expense category list (not a hardcoded enum, so new categories can be added without a deploy).
 */
model ExpenseCategory {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses Expense[]

  @@unique([companyId, name])
  @@index([companyId])
}

/**
 * Material Issue — Material Receipt → Inventory → Material Issue → Project Consumption.
 * Stock is decremented exactly once at creation time (mirroring Material Receipt);
 * editing an issue afterward only touches administrative fields, never quantity/
 * project/material, and soft-deleting one deliberately does NOT restore stock.
 */
model MaterialIssue {
  id                 String    @id @default(cuid())
  companyId          String
  company            Company   @relation(fields: [companyId], references: [id])
  projectId          String
  project            Project   @relation(fields: [projectId], references: [id])
  inventoryId        String
  inventory          Inventory @relation(fields: [inventoryId], references: [id])
  subWorkId          String?
  subWork            SubWork?  @relation(fields: [subWorkId], references: [id])
  issueNumber        String    @unique
  issuedDate         DateTime  @default(now())
  itemName           String
  warehouse          String?
  quantity           Decimal   @db.Decimal(12, 2)
  unit               String?
  purpose            String?
  issuedTo           String?
  approvedBy         String?
  remarks            String?
  attachmentFileName String?
  attachmentFileUrl  String?
  createdById        String
  createdBy          User      @relation(fields: [createdById], references: [id])
  isDeleted          Boolean   @default(false)
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([companyId])
  @@index([projectId])
  @@index([inventoryId])
  @@index([subWorkId])
  @@index([issuedDate])
  @@index([isDeleted])
}

/**
 * Labour Master — a worker record. Daily attendance, wage rates, advances, and
 * payments are all separate time-series tables referencing this one, rather than
 * flat fields here, since each of those changes independently over time.
 * "Labour Contractor" is deliberately NOT a separate entity — it's a Vendor with
 * category "Labour", reused directly so contractor payments flow through the
 * existing Vendor Bill / Vendor Payment pipeline without duplicating a contact.
 */
model Labour {
  id           String         @id @default(cuid())
  companyId    String
  company      Company        @relation(fields: [companyId], references: [id])
  projectId    String?
  project      Project?       @relation(fields: [projectId], references: [id])
  contractorId String?
  contractor   Vendor?        @relation(fields: [contractorId], references: [id])
  groupId      String?
  group        LabourGroup?   @relation(fields: [groupId], references: [id])
  name         String
  phone        String?
  designation  String?
  category     LabourCategory @default(UNSKILLED)
  status       String         @default("Active")
  remarks      String?
  createdById  String
  createdBy    User           @relation(fields: [createdById], references: [id])
  isDeleted    Boolean        @default(false)
  deletedAt    DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  wageRates   LabourWageRate[]
  attendances LabourAttendance[]
  advances    LabourAdvance[]
  payments    LabourPayment[]

  @@index([companyId])
  @@index([projectId])
  @@index([contractorId])
  @@index([groupId])
  @@index([category])
  @@index([isDeleted])
}

model LabourGroup {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id])
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  labours Labour[]

  @@index([companyId])
  @@index([projectId])
}

/**
 * A new row is created whenever a worker's rate changes; the latest one with effectiveFrom <= a given date is "current" as of that date.
 */
model LabourWageRate {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  labourId      String
  labour        Labour   @relation(fields: [labourId], references: [id])
  dailyWage     Decimal  @db.Decimal(12, 2)
  overtimeRate  Decimal  @default(0) @db.Decimal(12, 2)
  effectiveFrom DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([companyId])
  @@index([labourId])
  @@index([effectiveFrom])
}

/**
 * One row per worker per day. Wage amount is snapshotted at marking time from the rate in effect that day, so later rate changes never rewrite history.
 */
model LabourAttendance {
  id                   String           @id @default(cuid())
  companyId            String
  company              Company          @relation(fields: [companyId], references: [id])
  projectId            String
  project              Project          @relation(fields: [projectId], references: [id])
  siteId               String
  site                 Site             @relation(fields: [siteId], references: [id])
  labourId             String
  labour               Labour           @relation(fields: [labourId], references: [id])
  subWorkId            String?
  subWork              SubWork?         @relation(fields: [subWorkId], references: [id])
  attendanceDate       DateTime         @default(now())
  status               AttendanceStatus @default(PRESENT)
  overtimeHours        Decimal          @default(0) @db.Decimal(6, 2)
  dailyWageSnapshot    Decimal          @db.Decimal(12, 2)
  overtimeRateSnapshot Decimal          @default(0) @db.Decimal(12, 2)
  wageAmount           Decimal          @db.Decimal(12, 2)
  remarks              String?
  createdById          String
  createdBy            User             @relation(fields: [createdById], references: [id])
  isDeleted            Boolean          @default(false)
  deletedAt            DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@unique([labourId, attendanceDate])
  @@index([companyId])
  @@index([projectId])
  @@index([siteId])
  @@index([labourId])
  @@index([subWorkId])
  @@index([attendanceDate])
  @@index([isDeleted])
}

/**
 * A cash draw against future wages — never auto-linked to a Site Expense (it's recoverable, not spent).
 */
model LabourAdvance {
  id                   String              @id @default(cuid())
  companyId            String
  company              Company             @relation(fields: [companyId], references: [id])
  labourId             String
  labour               Labour              @relation(fields: [labourId], references: [id])
  projectId            String?
  project              Project?            @relation(fields: [projectId], references: [id])
  amount               Decimal             @db.Decimal(12, 2)
  advanceDate          DateTime            @default(now())
  mode                 String
  companyBankAccountId String?
  companyBankAccount   CompanyBankAccount? @relation(fields: [companyBankAccountId], references: [id])
  remarks              String?
  createdById          String
  createdBy            User                @relation(fields: [createdById], references: [id])
  isDeleted            Boolean             @default(false)
  deletedAt            DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([companyId])
  @@index([labourId])
  @@index([projectId])
  @@index([advanceDate])
  @@index([isDeleted])
}

/**
 * A wage settlement. Optionally linked to a Site Expense (opt-in via logAsExpense at creation) — never automatic.
 */
model LabourPayment {
  id                   String              @id @default(cuid())
  companyId            String
  company              Company             @relation(fields: [companyId], references: [id])
  labourId             String
  labour               Labour              @relation(fields: [labourId], references: [id])
  projectId            String?
  project              Project?            @relation(fields: [projectId], references: [id])
  amount               Decimal             @db.Decimal(12, 2)
  paymentDate          DateTime            @default(now())
  periodFrom           DateTime?
  periodTo             DateTime?
  mode                 String
  companyBankAccountId String?
  companyBankAccount   CompanyBankAccount? @relation(fields: [companyBankAccountId], references: [id])
  expenseId            String?             @unique
  expense              Expense?            @relation(fields: [expenseId], references: [id])
  remarks              String?
  createdById          String
  createdBy            User                @relation(fields: [createdById], references: [id])
  isDeleted            Boolean             @default(false)
  deletedAt            DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  allocation TransactionAllocation?

  @@index([companyId])
  @@index([labourId])
  @@index([projectId])
  @@index([paymentDate])
  @@index([isDeleted])
}

model Equipment {
  id                  String          @id @default(cuid())
  companyId           String
  company             Company         @relation(fields: [companyId], references: [id])
  projectId           String?
  project             Project?        @relation(fields: [projectId], references: [id])
  assetNumber         String?
  assetName           String
  equipmentType       String
  registrationNumber  String?
  operatorName        String?
  fuelConsumption     Decimal?        @db.Decimal(12, 2)
  runningHours        Decimal?        @db.Decimal(10, 2)
  maintenanceSchedule String?
  maintenanceDue      DateTime?
  breakdownNotes      String?
  currentSite         String?
  status              EquipmentStatus @default(RUNNING)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([companyId])
  @@index([projectId])
  @@index([status])
}

/**
 * Measurement Book (MB) — deliberately NOT a full engineering measurement book. Government
 * engineers maintain the official detailed MB on paper/their own system; AP OS only tracks
 * the official MB Number, the Abstract Sheet (BOQ rows with auto-calculated quantity/amount),
 * and attachments. Quantity/Effective Rate/Amount on each MeasurementBookItem are the ONLY
 * numbers the Running Bill module reads — it must never recompute them itself.
 * `raBillNumber` is a free-text label only (the engineer's own "this MB is for RA-2" note) —
 * it is NOT the same as RunningBill.billNumber, which is set later when the bill is actually
 * raised; the two are never reconciled/validated against each other.
 * `sourceRecapRevisionId` records which Recapitulation revision's rates/particulars seeded this
 * MB's rows (via "Load from Recapitulation"), purely for traceability — an MB can still be built
 * without one (manual BOQ entry, the original flow, keeps working unchanged).
 * `abstractPdfUrl`/`abstractPdfName` are a simple stored reference (this app has no binary file
 * upload pipeline anywhere else either — see CompanyBankAccount/Document's own fileUrl fields),
 * not a new upload subsystem.
 */
model MeasurementBook {
  id                    String                @id @default(cuid())
  companyId             String
  company               Company               @relation(fields: [companyId], references: [id])
  projectId             String
  project               Project               @relation(fields: [projectId], references: [id])
  siteId                String
  siteRecord            Site                  @relation(fields: [siteId], references: [id])
  subWorkId             String?
  subWork               SubWork?              @relation(fields: [subWorkId], references: [id])
  // Manually entered by the engineer (the government-issued official MB number) — unique per
  // company, not globally, since different departments run their own independent numbering.
  mbNumber              String
  raBillNumber          String?
  mbDate                DateTime              @default(now())
  site                  String?
  engineerId            String?
  engineer              User?                 @relation("MBEngineer", fields: [engineerId], references: [id])
  contractorId          String?
  contractor            Vendor?               @relation(fields: [contractorId], references: [id])
  status                MeasurementBookStatus @default(DRAFT)
  remarks               String?
  abstractPdfUrl        String?
  abstractPdfName       String?
  sourceRecapRevisionId String?
  sourceRecapRevision   SiteRecapRevision?    @relation(fields: [sourceRecapRevisionId], references: [id])
  // Form 58 footer config — Above/Below is the signed tender premium/rebate % applied to the
  // Abstract's Total Amount; GST % is applied after that adjustment. Both default to 0 (no
  // effect) and are the only two footer inputs ever stored — Net Value/Grand Total are always
  // computed live from these plus the item totals, never persisted.
  aboveBelowPercent     Decimal               @default(0) @db.Decimal(5, 2)
  gstPercent            Decimal               @default(0) @db.Decimal(5, 2)

  createdById String
  createdBy   User     @relation("MBCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       MeasurementBookItem[]
  documents   Document[]
  // One Approved MB can be linked to at most one Running Bill — enforced by the @unique
  // on RunningBill.measurementBookId, not here (the "many" side of a Prisma 1:1 relation
  // always declares the field as optional-singular, the unique constraint lives on the FK).
  runningBill RunningBill?
  emailLogs   MBEmailLog[]
  fieldAudits MeasurementItemFieldAudit[]

  @@unique([companyId, mbNumber])
  @@index([companyId])
  @@index([projectId])
  @@index([siteId])
  @@index([subWorkId])
  @@index([status])
  @@index([sourceRecapRevisionId])
}

/**
 * One Abstract Sheet row (unlimited per MB). Quantity/Effective Rate/Amount are always
 * server-recomputed from Length/Breadth/Height, BOQ Rate, and Payment % — the engineer
 * never enters them directly, and the client's calculated values are never trusted.
 * `previousQuantity`/`totalQuantity`/`previousAmount`/`totalAmount` are the Auto Carry
 * Forward fields: `previousQuantity` is auto-populated from the immediately preceding MB's
 * `totalQuantity` for the same `subWorkId` (0 for the very first MB of that Sub Work — see
 * computePreviousQuantityForItem in measurement-book.service.ts) and `totalQuantity =
 * previousQuantity + quantity`. This is a SEPARATE carry-forward from the one Running Bill
 * already performs across RunningBillItem history (running-bill.service.ts is untouched by
 * this) — this one exists so the Abstract MB itself shows progressive certified quantity
 * before a Running Bill is ever raised. `subWorkId` is what the carry-forward is keyed on;
 * it's nullable so old, manually-entered BOQ-item rows (matched instead by `boqItemNo`) keep
 * working exactly as before.
 */
model MeasurementBookItem {
  id                String          @id @default(cuid())
  companyId         String
  company           Company         @relation(fields: [companyId], references: [id])
  measurementBookId String
  measurementBook   MeasurementBook @relation(fields: [measurementBookId], references: [id])
  subWorkId         String?
  subWork           SubWork?        @relation(fields: [subWorkId], references: [id])
  sortOrder         Int             @default(0)
  boqItemNo         String
  boqDescription    String
  unit              String
  length            Decimal?        @db.Decimal(12, 4)
  breadth           Decimal?        @db.Decimal(12, 4)
  height            Decimal?        @db.Decimal(12, 4)
  quantity          Decimal         @default(0) @db.Decimal(14, 4)
  boqRate           Decimal         @default(0) @db.Decimal(14, 2)
  paymentPercent    Decimal         @default(100) @db.Decimal(5, 2)
  effectiveRate     Decimal         @default(0) @db.Decimal(14, 2)
  amount            Decimal         @default(0) @db.Decimal(14, 2)
  previousQuantity  Decimal         @default(0) @db.Decimal(14, 4)
  totalQuantity     Decimal         @default(0) @db.Decimal(14, 4)
  previousAmount    Decimal         @default(0) @db.Decimal(14, 2)
  totalAmount       Decimal         @default(0) @db.Decimal(14, 2)
  remarks           String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([companyId])
  @@index([measurementBookId])
  @@index([subWorkId])
}

/**
 * Audit trail for the two Abstract MB fields Government revisions can force a change to after
 * the fact: Previous Qty and Rate (see measurement-book.service.ts). Keyed by `boqItemNo` rather
 * than a MeasurementBookItem id because updateMB deletes and recreates all items on every save
 * (the existing, unchanged persistence pattern) — an item's own id does not survive an edit, but
 * its `boqItemNo` identity within the MB does.
 */
model MeasurementItemFieldAudit {
  id                String          @id @default(cuid())
  companyId         String
  company           Company         @relation(fields: [companyId], references: [id])
  measurementBookId String
  measurementBook   MeasurementBook @relation(fields: [measurementBookId], references: [id])
  boqItemNo         String
  fieldName         String
  oldValue          String
  newValue          String
  reason            String
  changedById       String
  changedBy         User            @relation(fields: [changedById], references: [id])
  changedAt         DateTime        @default(now())

  @@index([companyId])
  @@index([measurementBookId])
}

/**
 * Running Bill — the client-billing module, and the direct system representation of one
 * Government Form No. 58 (one RA Bill = one Form 58 = one RunningBill row). Historically every
 * Running Bill was generated from an Approved Measurement Book; as of the Form 58 redesign, new
 * bills are created directly against a Site's Bill Item Master (see SiteBillItem) and
 * measurementBookId is optional — only populated on bills created by the (retired-for-new-use,
 * kept read-only) Measurement Book flow. raSequence is the per-Site RA Bill ordering (RA Bill 1,
 * 2, 3...), independent of any other Site's numbering — the authoritative key for "copy from the
 * immediately preceding bill", since billNumber itself is free text and not guaranteed sequential.
 */
model RunningBill {
  id                      String           @id @default(cuid())
  companyId               String
  company                 Company          @relation(fields: [companyId], references: [id])
  projectId               String
  project                 Project          @relation(fields: [projectId], references: [id])
  siteId                  String
  siteRecord              Site             @relation(fields: [siteId], references: [id])
  subWorkId               String?
  subWork                 SubWork?         @relation(fields: [subWorkId], references: [id])
  measurementBookId       String?          @unique
  measurementBook         MeasurementBook? @relation(fields: [measurementBookId], references: [id])
  // Per-Site sequential ordering for Form 58 bills — null only for legacy MB-sourced bills that
  // predate this column. Never user-editable; always the next integer for that Site.
  raSequence              Int?
  billNumber              String
  billType                BillType        @default(RA_BILL)
  site                    String?
  // Retired from the Form 58 create/edit UI (Client Payment Workflow milestone) — replaced by
  // billSubmittedDate below. Columns kept (nullable, unused by new bills) so historical rows
  // that already have a period recorded are never destructively dropped.
  billPeriodFrom          DateTime?
  billPeriodTo            DateTime?
  billDate                DateTime        @default(now())
  // The date the physical/government bill was submitted — distinct from `submittedAt` (the
  // workflow status-transition timestamp set by submitRunningBill).
  billSubmittedDate       DateTime?
  // Cumulative-to-date certified value of the work, before deductions. current = total - previous
  // (this bill's own net-new certified value); total/previous are the running cumulative figures
  // across every Running Bill raised so far for this project (see computeItemCalc in the service).
  previousCertifiedAmount Decimal         @default(0) @db.Decimal(14, 2)
  currentCertifiedAmount  Decimal         @default(0) @db.Decimal(14, 2)
  totalCertifiedAmount    Decimal         @default(0) @db.Decimal(14, 2)
  // Form 58 calculation flow (Site Management & Financial Workflow Refinement, Form 58 redesign)
  // — frozen into the bill at creation time from the Site's Work Order values, and NEVER
  // recalculated afterward even if the Site's tenderAboveBelowPercent/gstPercent later change.
  // Grand Total of Items = currentCertifiedAmount above. Flow: currentCertifiedAmount ->
  // + tenderAdjustmentAmount = adjustedTotal -> + gstAmount = grossBillAmount -> + roundOff =
  // finalBillAmount -> - totalDeductions = netPayable.
  tenderAboveBelowPercent Decimal?        @db.Decimal(5, 2)
  tenderAdjustmentAmount  Decimal?        @db.Decimal(14, 2)
  adjustedTotal           Decimal?        @db.Decimal(14, 2)
  gstPercent              Decimal?        @db.Decimal(5, 2)
  gstAmount               Decimal?        @db.Decimal(14, 2)
  // Form 58 UI & Workflow Refinement — an optional additional percentage the user enters when
  // Government billing GST differs from the Work Order's own gstPercent above. Frozen into the
  // bill at creation exactly like every other calc-flow field; Total GST (never stored — always
  // gstAmount + gstDifferenceAmount) feeds into grossBillAmount below.
  gstDifferencePercent    Decimal?        @db.Decimal(5, 2)
  gstDifferenceAmount     Decimal?        @db.Decimal(14, 2)
  grossBillAmount         Decimal?        @db.Decimal(14, 2)
  roundOff                Decimal?        @db.Decimal(14, 2)
  finalBillAmount         Decimal?        @db.Decimal(14, 2)
  totalDeductions         Decimal         @default(0) @db.Decimal(14, 2)
  netPayable              Decimal         @default(0) @db.Decimal(14, 2)
  amountReceived          Decimal         @default(0) @db.Decimal(14, 2)
  outstandingAmount       Decimal         @default(0) @db.Decimal(14, 2)
  status                  BillStatus      @default(DRAFT)
  submittedAt             DateTime?
  passedAt                DateTime?
  remarks                 String?

  createdById String
  createdBy   User     @relation("RunningBillCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items      RunningBillItem[]
  deductions RunningBillDeduction[]
  payments   RunningBillPayment[]
  documents  Document[]
  emailLogs  RunningBillEmailLog[]

  // Bill numbering is independent per Site, not per Company — the same "RA-1" label is expected
  // to exist on every Site (see raSequence's own comment above).
  @@unique([siteId, billNumber])
  @@unique([siteId, raSequence])
  @@index([companyId])
  @@index([projectId])
  @@index([siteId])
  @@index([subWorkId])
  @@index([status])
  @@index([billType])
}

/**
 * One Abstract row per billed item. For Form 58 bills (siteBillItemId set), the row is a
 * snapshot of that SiteBillItem's description/unit/rate at billing time PLUS this bill's own
 * quantities — the master can be edited going forward without ever rewriting a historical bill's
 * figures. previousQuantity is the cumulative quantity already certified for this item across
 * every earlier Running Bill on the same Site (computed server-side, never client-supplied).
 * Legacy MB-sourced rows have siteBillItemId null and are matched by boqItemNo instead, unchanged
 * from before.
 */
model RunningBillItem {
  id               String       @id @default(cuid())
  companyId        String
  company          Company      @relation(fields: [companyId], references: [id])
  runningBillId    String
  runningBill      RunningBill  @relation(fields: [runningBillId], references: [id])
  siteBillItemId   String?
  siteBillItem     SiteBillItem? @relation(fields: [siteBillItemId], references: [id])
  sortOrder        Int          @default(0)
  boqItemNo        String
  boqDescription   String
  unit             String
  previousQuantity Decimal      @default(0) @db.Decimal(14, 4)
  currentQuantity  Decimal      @default(0) @db.Decimal(14, 4)
  totalQuantity    Decimal      @default(0) @db.Decimal(14, 4)
  boqRate          Decimal      @default(0) @db.Decimal(14, 2)
  paymentPercent   Decimal      @default(100) @db.Decimal(5, 2)
  effectiveRate    Decimal      @default(0) @db.Decimal(14, 2)
  previousAmount   Decimal      @default(0) @db.Decimal(14, 2)
  currentAmount    Decimal      @default(0) @db.Decimal(14, 2)
  totalAmount      Decimal      @default(0) @db.Decimal(14, 2)
  remarks          String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([companyId])
  @@index([runningBillId])
  @@index([boqItemNo])
  @@index([siteBillItemId])
}

/**
 * Bill Item Master — one row per billable item, per Site, forever. This is the authoritative
 * identity Form 58 bills carry forward: RA Bill 1 creates these rows as items are entered; every
 * later RA Bill auto-includes every active item here (Current Quantity defaults to 0 if untouched
 * — items already billed must never disappear); a brand-new item entered on any later bill creates
 * a new row here automatically, so it appears on every bill after that too. Rate lives here as the
 * current/canonical value — each RunningBillItem still snapshots its own rate at billing time, so
 * editing the master rate never rewrites historical bills.
 */
model SiteBillItem {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  siteId      String
  site        Site     @relation(fields: [siteId], references: [id])
  subWorkId   String?
  subWork     SubWork? @relation(fields: [subWorkId], references: [id])
  itemNo      String
  description String
  unit        String
  rate        Decimal  @default(0) @db.Decimal(14, 2)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdById String
  createdBy   User     @relation("SiteBillItemCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  billItems RunningBillItem[]

  @@index([companyId])
  @@index([siteId])
  @@index([subWorkId])
}

/**
 * Named (Security Deposit/GST/Labour Cess/Royalty/TDS/Mobilization Recovery) or custom (OTHER + label) deduction row — unlimited per bill.
 */
model RunningBillDeduction {
  id            String        @id @default(cuid())
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id])
  runningBillId String
  runningBill   RunningBill   @relation(fields: [runningBillId], references: [id])
  type          DeductionType @default(OTHER)
  label         String
  amount        Decimal       @default(0) @db.Decimal(14, 2)
  remarks       String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([companyId])
  @@index([runningBillId])
}

/**
 * Payment Received against a Running Bill — a dedicated ledger (mirrors VendorPayment for
 * Vendor Bills) rather than the generic Payment table, so the client-receipts ledger stays
 * self-contained. Multiple payments per bill are expected; RunningBill.amountReceived/
 * outstandingAmount/status are updated transactionally whenever one is recorded (see
 * recordRunningBillPayment in running-bill.service.ts) — this is the Bank Reconciliation
 * hook: companyBankAccountId records which company account the money landed in.
 */
model RunningBillPayment {
  id                   String              @id @default(cuid())
  companyId            String
  company              Company             @relation(fields: [companyId], references: [id])
  runningBillId        String
  runningBill          RunningBill         @relation(fields: [runningBillId], references: [id])
  projectId            String
  project              Project             @relation(fields: [projectId], references: [id])
  companyBankAccountId String?
  companyBankAccount   CompanyBankAccount? @relation(fields: [companyBankAccountId], references: [id])
  paymentNumber        String              @unique
  paymentDate          DateTime            @default(now())
  amount               Decimal             @db.Decimal(14, 2)
  mode                 String?
  referenceNumber      String?
  remarks              String?

  createdById String
  createdBy   User     @relation("RunningBillPaymentCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Reverse side of TransactionAllocation.runningBillPaymentId — set when this receipt was
  // created by allocating a bank statement line. Never populated by this module directly.
  allocation TransactionAllocation?

  @@index([companyId])
  @@index([runningBillId])
  @@index([projectId])
  @@index([companyBankAccountId])
}

/**
 * Audit log of Running Bill emails sent — mirrors MBEmailLog/DPREmailLog.
 */
model RunningBillEmailLog {
  id            String      @id @default(cuid())
  companyId     String
  company       Company     @relation(fields: [companyId], references: [id])
  runningBillId String
  runningBill   RunningBill @relation(fields: [runningBillId], references: [id])
  recipients    Json
  includedExcel Boolean     @default(false)
  sentById      String
  sentBy        User        @relation("RunningBillEmailSentBy", fields: [sentById], references: [id])
  sentAt        DateTime    @default(now())
  status        String      @default("SENT")
  errorMessage  String?

  @@index([companyId])
  @@index([runningBillId])
}

/**
 * Site Expenses (Cash Book) — expenses recorded directly against a project.
 * VENDOR_CREDIT payments deliberately do NOT create a Payment/VendorBill —
 * they just record the liability; reconciling it against a real Vendor Bill
 * later is a distinct, future workflow.
 */
model Expense {
  id                   String              @id @default(cuid())
  companyId            String
  company              Company             @relation(fields: [companyId], references: [id])
  projectId            String
  project              Project             @relation(fields: [projectId], references: [id])
  siteId               String
  site                 Site                @relation(fields: [siteId], references: [id])
  categoryId           String
  category             ExpenseCategory     @relation(fields: [categoryId], references: [id])
  vendorId             String?
  vendor               Vendor?             @relation(fields: [vendorId], references: [id])
  subWorkId            String?
  subWork              SubWork?            @relation(fields: [subWorkId], references: [id])
  expenseNumber        String              @unique
  expenseDate          DateTime            @default(now())
  description          String?
  amount               Decimal             @db.Decimal(12, 2)
  paymentMode          String
  companyBankAccountId String?
  companyBankAccount   CompanyBankAccount? @relation(fields: [companyBankAccountId], references: [id])
  // Credit Card Expense Workflow (Executive Dashboard milestone) — only populated when
  // paymentMode = "CREDIT_CARD"; points at a Liability with liabilityType = CREDIT_CARD.
  // Creating/editing/deleting an expense in this mode atomically adjusts that Liability's
  // outstandingAmount (see expense.service.ts) — the expense amount is never a second copy of
  // the card's balance, only the transaction that moved it.
  liabilityId          String?
  liability            Liability?          @relation(fields: [liabilityId], references: [id])
  attachmentFileName   String?
  attachmentFileUrl    String?
  remarks              String?
  // Machinery-specific fields — only populated when category.name is "Machinery";
  // amount is then auto-calculated as machineHours * machineRatePerHour.
  machineType          String?
  machineHours         Decimal?            @db.Decimal(10, 2)
  machineRatePerHour   Decimal?            @db.Decimal(12, 2)
  createdById          String
  createdBy            User                @relation(fields: [createdById], references: [id])
  isDeleted            Boolean             @default(false)
  deletedAt            DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  payments      Payment[]
  labourPayment LabourPayment?
  allocation    TransactionAllocation?

  @@index([companyId])
  @@index([machineType])
  @@index([projectId])
  @@index([siteId])
  @@index([categoryId])
  @@index([vendorId])
  @@index([subWorkId])
  @@index([companyBankAccountId])
  @@index([liabilityId])
  @@index([paymentMode])
  @@index([expenseDate])
  @@index([isDeleted])
}

model Payment {
  id              String         @id @default(cuid())
  companyId       String
  company         Company        @relation(fields: [companyId], references: [id])
  projectId       String?
  project         Project?       @relation(fields: [projectId], references: [id])
  vendorId        String?
  vendor          Vendor?        @relation(fields: [vendorId], references: [id])
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  expenseId       String?
  expense         Expense?       @relation(fields: [expenseId], references: [id])
  paymentNumber   String         @unique
  paymentDate     DateTime       @default(now())
  amount          Decimal        @default(0) @db.Decimal(12, 2)
  mode            String?
  remarks         String?
  status          PaymentStatus  @default(PENDING)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([companyId])
  @@index([status])
}

/**
 * Vendor Bill — the AP Construction workflow's central payable record.
 * Purchase Order and Material Receipt references are OPTIONAL: this company
 * normally orders materials by phone and bills them directly against the
 * vendor + project once delivered, without ever raising a PO.
 */
model VendorBill {
  id                 String           @id @default(cuid())
  companyId          String
  company            Company          @relation(fields: [companyId], references: [id])
  vendorId           String
  vendor             Vendor           @relation(fields: [vendorId], references: [id])
  projectId          String?
  project            Project?         @relation(fields: [projectId], references: [id])
  siteId             String?
  site               Site?            @relation(fields: [siteId], references: [id])
  purchaseOrderId    String?
  purchaseOrder      PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id])
  materialReceiptId  String?
  materialReceipt    MaterialReceipt? @relation(fields: [materialReceiptId], references: [id])
  subWorkId          String?
  subWork            SubWork?         @relation(fields: [subWorkId], references: [id])
  billNumber         String           @unique
  billDate           DateTime         @default(now())
  dueDate            DateTime?
  billAmount         Decimal          @default(0) @db.Decimal(12, 2)
  taxableAmount      Decimal          @default(0) @db.Decimal(12, 2)
  gstAmount          Decimal          @default(0) @db.Decimal(12, 2)
  totalAmount        Decimal          @default(0) @db.Decimal(12, 2)
  paidAmount         Decimal          @default(0) @db.Decimal(12, 2)
  outstandingBalance Decimal          @default(0) @db.Decimal(12, 2)
  invoiceFileName    String?
  invoiceFileUrl     String?
  status             VendorBillStatus @default(PENDING)
  notes              String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  payments VendorPayment[]

  @@index([companyId])
  @@index([vendorId])
  @@index([projectId])
  @@index([siteId])
  @@index([purchaseOrderId])
  @@index([materialReceiptId])
  @@index([subWorkId])
  @@index([status])
  @@index([dueDate])
}

/**
 * VendorPayment — a dedicated, first-class payment ledger for the Vendor Bill →
 * Vendor Payment workflow. Deliberately not the generic `Payment` model: this
 * keeps the vendor-payables ledger self-contained (bill, and both sides of the
 * bank transfer) rather than mixed into a catch-all table shared with
 * unrelated future concerns (expenses, client receipts, etc.).
 */
model VendorPayment {
  id                   String              @id @default(cuid())
  companyId            String
  company              Company             @relation(fields: [companyId], references: [id])
  vendorId             String
  vendor               Vendor              @relation(fields: [vendorId], references: [id])
  projectId            String?
  project              Project?            @relation(fields: [projectId], references: [id])
  vendorBillId         String
  vendorBill           VendorBill          @relation(fields: [vendorBillId], references: [id])
  companyBankAccountId String?
  companyBankAccount   CompanyBankAccount? @relation(fields: [companyBankAccountId], references: [id])
  vendorBankAccountId  String?
  vendorBankAccount    VendorBankAccount?  @relation(fields: [vendorBankAccountId], references: [id])
  paymentNumber        String              @unique
  paymentDate          DateTime            @default(now())
  amount               Decimal             @db.Decimal(12, 2)
  mode                 String?
  referenceNumber      String?
  attachmentFileName   String?
  attachmentFileUrl    String?
  remarks              String?
  // The vendor's outstanding balance is reduced exactly the same way regardless of these three
  // fields — they are display/audit metadata only, never an input to the payment math. Set when
  // the money was physically handed to someone other than the vendor itself (e.g. a site
  // supervisor collecting cash on the vendor's behalf); paidToName is who actually received it.
  paidToOtherParty     Boolean             @default(false)
  paidToName           String?
  paidToReason         String?
  status               PaymentStatus       @default(PAID)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  // Reverse side of TransactionAllocation.vendorPaymentId — set when this payment was
  // created by allocating a bank statement withdrawal. Never populated by this module directly.
  allocation TransactionAllocation?

  @@index([companyId])
  @@index([vendorId])
  @@index([vendorBillId])
  @@index([companyBankAccountId])
  @@index([vendorBankAccountId])
  @@index([status])
}

/**
 * Banking & Reconciliation — the bank/cash statement ledger. This is deliberately NOT where
 * money-movement amounts live for Running Bill receipts or Vendor payments; those stay solely
 * on RunningBillPayment/VendorPayment (never duplicated here). A BankTransaction represents an
 * actual bank statement line (entered manually or imported from Excel/CSV) and is reconciled
 * against the matching RunningBillPayment (deposit) or VendorPayment (withdrawal) via the two
 * optional @unique links below — see autoReconcile in bank-transaction.service.ts. Current
 * Balance for the owning CompanyBankAccount is always openingBalance + sum(deposit) -
 * sum(withdrawal) over these rows, computed on demand, never stored.
 */
/**
 * The bank/cash statement ledger — the single financial source of truth. A row created with
 * source=IMPORTED (from an uploaded statement) is permanently read-only: never edited, never
 * deleted, only ever allocated (see TransactionAllocation). MANUAL rows (entered directly, not
 * from a statement) remain editable, mirroring how a cash book entry predates its own record.
 * allocationStatus is a denormalized cache of sum(allocations.amount) vs (deposit+withdrawal),
 * recomputed by transaction-allocation.service.ts on every allocate/unallocate — kept as a real
 * column (not purely derived on read) so it stays filterable/indexable in listBankTransactions.
 */
model BankTransaction {
  id                   String                @id @default(cuid())
  companyId            String
  company              Company               @relation(fields: [companyId], references: [id])
  companyBankAccountId String
  companyBankAccount   CompanyBankAccount    @relation(fields: [companyBankAccountId], references: [id])
  transactionDate      DateTime
  deposit              Decimal               @default(0) @db.Decimal(14, 2)
  withdrawal           Decimal               @default(0) @db.Decimal(14, 2)
  referenceNumber      String?
  description          String?
  category             String?
  projectId            String?
  project              Project?              @relation(fields: [projectId], references: [id])
  allocationStatus     AllocationStatus      @default(UNALLOCATED)
  source               BankTransactionSource @default(MANUAL)
  // Business/batch identifier only, kept for backward-compatible reference — the authoritative
  // link from an imported row to its statement is bankStatementImportId below.
  importBatchId        String?
  // The one Import Statement this row came from — set only for source=IMPORTED rows, never for
  // MANUAL ones. This is the authoritative FK the Imported Statements feature (soft delete/
  // restore) operates on; every IMPORTED row always has exactly one, so there are no orphans.
  bankStatementImportId String?
  bankStatementImport   BankStatementImport? @relation(fields: [bankStatementImportId], references: [id])
  // Soft-delete visibility flag, flipped only by deleting/restoring the owning Import Statement
  // (never by editing a transaction directly). false = hidden from Banking/Allocation/Reports/
  // Dashboard but the row (and any allocations/ledger records it created) is never touched.
  isActive              Boolean              @default(true)

  allocations TransactionAllocation[]

  createdById String
  createdBy   User     @relation("BankTransactionCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
  @@index([companyBankAccountId])
  @@index([transactionDate])
  @@index([allocationStatus])
  @@index([projectId])
  @@index([importBatchId])
  @@index([bankStatementImportId])
  @@index([isActive])
}

/**
 * One row per statement-file import attempt (whether or not anything was actually inserted) —
 * the record that lets the importer warn "you already imported this exact file" BEFORE doing any
 * work, using fileHash (SHA-256 of the raw file bytes, computed client-side) + companyBankAccountId
 * as the identity. periodFrom/periodTo (min/max transaction date found in the file) are stored for
 * display/audit only — actual duplicate *transaction* detection (the thing that makes overlapping-
 * but-not-identical statements safe to re-import) happens row-by-row in bank-transaction.service.ts,
 * never by comparing whole statements.
 */
model BankStatementImport {
  id                   String   @id @default(cuid())
  companyId            String
  company              Company  @relation(fields: [companyId], references: [id])
  companyBankAccountId String
  companyBankAccount   CompanyBankAccount @relation(fields: [companyBankAccountId], references: [id])
  fileName             String?
  fileHash             String
  periodFrom           DateTime?
  periodTo             DateTime?
  totalRows            Int      @default(0)
  importedRows         Int      @default(0)
  skippedRows          Int      @default(0)
  importBatchId        String?
  createdById          String
  createdBy            User     @relation("BankStatementImportCreatedBy", fields: [createdById], references: [id])
  createdAt            DateTime @default(now())
  // Soft delete only — deleting a statement flips this + isActive:false on its transactions.
  // Never cascades to allocations or the ledger records they created (Vendor Payment, Running
  // Bill Receipt, etc.) — those are financial history and are never touched by this flag.
  isDeleted            Boolean  @default(false)
  deletedAt            DateTime?

  transactions BankTransaction[]
  auditLogs    BankStatementAuditLog[]

  @@index([companyId])
  @@index([companyBankAccountId])
  @@index([fileHash])
  @@index([isDeleted])
}

enum BankStatementAuditAction {
  IMPORTED
  DELETED
  RESTORED
}

/** One row per Import/Delete/Restore event on a Bank Statement Import — full history, not just the latest state. */
model BankStatementAuditLog {
  id                    String                    @id @default(cuid())
  companyId             String
  company               Company                   @relation(fields: [companyId], references: [id])
  bankStatementImportId String
  bankStatementImport   BankStatementImport       @relation(fields: [bankStatementImportId], references: [id])
  action                BankStatementAuditAction
  performedById         String
  performedBy           User                      @relation("BankStatementAuditPerformedBy", fields: [performedById], references: [id])
  performedAt           DateTime                  @default(now())
  notes                 String?

  @@index([companyId])
  @@index([bankStatementImportId])
}

/**
 * Remembers a manual column mapping the user chose once for a bank statement layout, keyed by a
 * signature computed from the header row's normalized text. The next file with the same header
 * layout (same bank/account export format) auto-applies this mapping instead of re-prompting.
 * Columns are stored by position (0-based index into the detected header row), not by name, since
 * the signature already pins the exact header text combination those positions were chosen against.
 */
model BankStatementMapping {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  signature       String
  bankName        String?
  dateColumn      Int
  descriptionColumn Int?
  debitColumn     Int?
  creditColumn    Int?
  balanceColumn   Int?
  referenceColumn Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([companyId, signature])
  @@index([companyId])
}

/**
 * One "this money was for X" declaration against a BankTransaction. Split allocation: a single
 * transaction can have many of these, across different AllocationTypes, as long as their amounts
 * never exceed the transaction's own deposit/withdrawal amount (enforced in
 * transaction-allocation.service.ts). Creating a RUNNING_BILL_RECEIPT/VENDOR_PAYMENT/LABOUR/
 * SITE_EXPENSE allocation atomically creates the matching RunningBillPayment/VendorPayment/
 * LabourPayment/Expense row (linked back here 1:1) — the allocation is never a second copy of
 * that amount, only the pointer to it. siteId drives the Site Workspace's Site Wallet rollup and
 * is set directly on the allocation (not inferred from the downstream row) so every allocation
 * type, including the 7 with no dedicated ledger, can still be attributed to a Site.
 */
model TransactionAllocation {
  id                String          @id @default(cuid())
  companyId         String
  company           Company         @relation(fields: [companyId], references: [id])
  bankTransactionId String
  bankTransaction   BankTransaction @relation(fields: [bankTransactionId], references: [id])
  allocationType    AllocationType
  amount            Decimal         @db.Decimal(14, 2)
  siteId            String?
  site              Site?           @relation(fields: [siteId], references: [id])
  partyName         String?
  notes             String?

  runningBillPaymentId String?             @unique
  runningBillPayment   RunningBillPayment? @relation(fields: [runningBillPaymentId], references: [id])
  vendorPaymentId      String?             @unique
  vendorPayment        VendorPayment?      @relation(fields: [vendorPaymentId], references: [id])
  labourPaymentId      String?             @unique
  labourPayment        LabourPayment?      @relation(fields: [labourPaymentId], references: [id])
  expenseId            String?             @unique
  expense              Expense?            @relation(fields: [expenseId], references: [id])
  partnerInvestmentId  String?             @unique
  partnerInvestment    PartnerInvestment?  @relation(fields: [partnerInvestmentId], references: [id])
  partnerSettlementId  String?             @unique
  partnerSettlement    PartnerSettlement?  @relation(fields: [partnerSettlementId], references: [id])

  // LIABILITY_DISBURSEMENT tags a deposit directly with the Liability it came from (a straight
  // pass-through pointer, mirroring how siteId tags an allocation — no dedicated ledger row is
  // needed since the BankTransaction itself already holds the amount/date/account).
  // LIABILITY_REPAYMENT instead creates a real LiabilityRepayment row (principal/interest split),
  // linked back here 1:1 exactly like runningBillPaymentId/vendorPaymentId above.
  liabilityId          String?
  liability            Liability?          @relation(fields: [liabilityId], references: [id])
  liabilityRepaymentId String?             @unique
  liabilityRepayment   LiabilityRepayment? @relation(fields: [liabilityRepaymentId], references: [id])

  // EMPLOYEE_SALARY / SITE_ADVANCE / PERSONAL_ADVANCE tag directly with the Employee, the same
  // no-dedicated-ledger pattern as liabilityId above — Employee Reports read straight off these
  // allocation rows (filtered by employeeId + allocationType + date range), never a second total.
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id])

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([companyId])
  @@index([bankTransactionId])
  @@index([siteId])
  @@index([allocationType])
  @@index([liabilityId])
  @@index([employeeId])
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

/**
 * Lightweight internal-staff registry — deliberately NOT a payroll/HR module (no attendance, no
 * PF/ESIC, no salary structure). Exists purely so bank transactions allocated as Employee Salary /
 * Site Advance / Personal Advance can tag a real person, and Employee Reports can aggregate those
 * tags. Distinct from Labour (site/project daily-wage workforce, attendance-driven wage calc).
 */
model Employee {
  id          String         @id @default(cuid())
  companyId   String
  company     Company        @relation(fields: [companyId], references: [id])
  name        String
  // System-generated, permanent, read-only — EMP/<FY>/<Seq>.
  code        String?
  mobile      String?
  designation String?
  department  String?
  status      EmployeeStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  allocations TransactionAllocation[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([status])
}

enum BankAccountOwnerType {
  COMPANY
  EMPLOYEE
  VENDOR
  CLIENT
  PARTNER
  LIABILITY
  OTHER
}

enum BankAccountStatus {
  ACTIVE
  INACTIVE
  CLOSED
}

/**
 * Unified Bank Account Master — one place any bank account belonging to any kind of owner is
 * recorded, instead of each owner type growing its own bank-account table. companyId scopes the
 * account to a tenant; ownerType + ownerId then scopes it to whichever entity actually holds it
 * (an Employee, Client, Partner, Liability's lender, or a free-form "Other" owner named via
 * ownerLabel). CompanyBankAccount and VendorBankAccount remain the source of truth for Company and
 * Vendor accounts respectively (too deeply wired into Banking/Vendor Payments to safely migrate in
 * this phase) — this master is for every owner type that had no bank-account storage before.
 */
model BankAccountMaster {
  id              String               @id @default(cuid())
  companyId       String
  company         Company              @relation(fields: [companyId], references: [id])
  ownerType       BankAccountOwnerType
  ownerId         String?
  ownerLabel      String?
  bankName        String
  branch          String?
  accountHolder   String?
  accountNumber   String
  ifscCode        String
  upiId           String?
  isPrimary       Boolean              @default(false)
  status          BankAccountStatus    @default(ACTIVE)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([companyId])
  @@index([ownerType])
  @@index([ownerId])
}

/**
 * Partner Master — Owners and Partners are both rows here (partnerType distinguishes them),
 * global to the Company, never tied to a Project or Site. sharePercent drives the Profit Sharing
 * report (a computed report, never a stored profit figure — see partnership-reports.service.ts).
 */
model Partner {
  id           String      @id @default(cuid())
  companyId    String
  company      Company     @relation(fields: [companyId], references: [id])
  name         String
  // System-generated, permanent, read-only — PTR/<FY>/<Seq>.
  code         String?
  partnerType  PartnerType @default(PARTNER)
  phone        String?
  email        String?
  address      String?
  panNumber    String?
  sharePercent Decimal     @default(0) @db.Decimal(5, 2)
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  investments PartnerInvestment[]
  settlements PartnerSettlement[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([partnerType])
}

/**
 * A Partner's capital contribution into the company — always global, never Site-scoped at the
 * point of investment (that money is only later attributed to a Site once it's spent, via a
 * SITE_EXPENSE/LABOUR TransactionAllocation out of the same bank account it landed in). Created
 * either directly (a cash investment) or via allocating a bank deposit
 * (OWNER_INVESTMENT/PARTNER_INVESTMENT) — mirrors the VendorPayment/LabourPayment dual-path
 * pattern exactly.
 */
model PartnerInvestment {
  id                   String              @id @default(cuid())
  companyId            String
  company              Company             @relation(fields: [companyId], references: [id])
  partnerId            String
  partner              Partner             @relation(fields: [partnerId], references: [id])
  investmentNumber     String              @unique
  amount               Decimal             @db.Decimal(14, 2)
  investmentDate       DateTime            @default(now())
  mode                 String
  companyBankAccountId String?
  companyBankAccount   CompanyBankAccount? @relation(fields: [companyBankAccountId], references: [id])
  referenceNumber      String?
  remarks              String?
  createdById          String
  createdBy            User                @relation(fields: [createdById], references: [id])
  createdAt            DateTime            @default(now())

  allocation TransactionAllocation?

  @@index([companyId])
  @@index([partnerId])
}

/**
 * Money paid OUT to a Partner — a profit distribution or a return of capital. The counterpart
 * of PartnerInvestment; same dual-path (direct entry or PARTNER_SETTLEMENT allocation).
 */
model PartnerSettlement {
  id                   String              @id @default(cuid())
  companyId            String
  company              Company             @relation(fields: [companyId], references: [id])
  partnerId            String
  partner              Partner             @relation(fields: [partnerId], references: [id])
  settlementNumber     String              @unique
  settlementType       SettlementType      @default(OTHER)
  amount               Decimal             @db.Decimal(14, 2)
  settlementDate       DateTime            @default(now())
  mode                 String
  companyBankAccountId String?
  companyBankAccount   CompanyBankAccount? @relation(fields: [companyBankAccountId], references: [id])
  referenceNumber      String?
  remarks              String?
  createdById          String
  createdBy            User                @relation(fields: [createdById], references: [id])
  createdAt            DateTime            @default(now())

  allocation TransactionAllocation?

  @@index([companyId])
  @@index([partnerId])
}

/**
 * Finance Module — Liability Master. Every borrowing the company carries (Home/Car/Gold/Bank
 * Loan, Cash Credit, Overdraft, Credit Card, Friend/Relative/Private/Personal loans). Global to
 * the Company, never Site-scoped at this layer — same rule as Partner: money is only attributed
 * to a Site once it's spent, via the existing TransactionAllocation engine (siteId already lives
 * on that model). outstandingAmount is a real stored column (not purely derived) because it is
 * the master's own starting position for a liability entered mid-life (a loan already partly
 * repaid before AP OS existed) — it is then only ever decremented by recordLiabilityRepayment in
 * liability-repayment.service.ts, exactly like RunningBill.amountReceived/outstandingAmount.
 */
model Liability {
  id                String                @id @default(cuid())
  companyId         String
  company           Company               @relation(fields: [companyId], references: [id])
  loanName          String
  // System-generated, permanent, read-only — LIA/<FY>/<Seq>.
  code              String?
  liabilityType     LiabilityType
  lenderName        String?
  // Friend/Relative loans have no bank of their own — this is the lender's own mobile number.
  lenderMobile      String?
  bankName          String?
  branch            String?
  accountNumber     String?
  // The lender's own loan/account reference, distinct from `accountNumber` (the bank account
  // used to service it) — e.g. a Gold Loan's loan number differs from the linked SB account.
  loanNumber        String?
  sanctionAmount    Decimal               @db.Decimal(14, 2)
  outstandingAmount Decimal               @db.Decimal(14, 2)
  interestType      LiabilityInterestType @default(NONE)
  interestRate      Decimal               @default(0) @db.Decimal(6, 3)
  emiAmount         Decimal               @default(0) @db.Decimal(12, 2)
  emiDate           Int?
  // Credit Card / Cash Credit / Overdraft only: the statement generation day-of-month, distinct
  // from emiDate (the payment due day). Minimum Due is likewise Credit-Card-specific; Available
  // Limit is deliberately NOT stored here — it's always sanctionAmount - outstandingAmount,
  // computed on demand in finance-reports.service.ts, same "never store a derivable total" rule
  // used everywhere else in this schema.
  statementDate     Int?
  minimumDue        Decimal               @default(0) @db.Decimal(12, 2)
  startDate         DateTime
  endDate           DateTime?
  security          LiabilitySecurity     @default(NONE)
  status            LiabilityStatus       @default(ACTIVE)
  notes             String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  repayments  LiabilityRepayment[]
  allocations TransactionAllocation[]
  creditCardExpenses Expense[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([liabilityType])
  @@index([status])
}

/**
 * A single repayment against a Liability — always created from Bank Statement → Transaction
 * Allocation (see transaction-allocation.service.ts's LIABILITY_REPAYMENT case), never entered
 * directly; there is deliberately no public "create repayment" endpoint. principalPaid reduces
 * Liability.outstandingAmount; interestPaid is a pure cost with no effect on the balance —
 * together they must equal totalPaid, which must equal the originating allocation's amount
 * (validated in liability-repayment.service.ts), so this is never a second copy of the bank
 * transaction's own figure.
 */
model LiabilityRepayment {
  id                    String             @id @default(cuid())
  companyId             String
  company               Company            @relation(fields: [companyId], references: [id])
  liabilityId           String
  liability             Liability          @relation(fields: [liabilityId], references: [id])
  repaymentNumber       String             @unique
  paymentDate           DateTime
  principalPaid         Decimal            @db.Decimal(12, 2)
  interestPaid          Decimal            @db.Decimal(12, 2)
  totalPaid             Decimal            @db.Decimal(12, 2)
  companyBankAccountId  String
  companyBankAccount    CompanyBankAccount @relation(fields: [companyBankAccountId], references: [id])
  remarks               String?
  createdById           String
  createdBy             User               @relation(fields: [createdById], references: [id])
  createdAt             DateTime           @default(now())

  allocation TransactionAllocation?

  @@index([companyId])
  @@index([liabilityId])
  @@index([paymentDate])
}

model Document {
  id                    String               @id @default(cuid())
  companyId             String
  company               Company              @relation(fields: [companyId], references: [id])
  projectId             String?
  project               Project?             @relation(fields: [projectId], references: [id])
  siteId                String?
  site                  Site?                @relation(fields: [siteId], references: [id])
  clientId              String?
  client                Client?              @relation(fields: [clientId], references: [id])
  vendorId              String?
  vendor                Vendor?              @relation(fields: [vendorId], references: [id])
  purchaseOrderId       String?
  purchaseOrder         PurchaseOrder?       @relation(fields: [purchaseOrderId], references: [id])
  purchaseRequisitionId String?
  purchaseRequisition   PurchaseRequisition? @relation(fields: [purchaseRequisitionId], references: [id])
  materialReceiptId     String?
  materialReceipt       MaterialReceipt?     @relation(fields: [materialReceiptId], references: [id])
  dprId                 String?
  dpr                   DailyProgressReport? @relation(fields: [dprId], references: [id])
  measurementBookId     String?
  measurementBook       MeasurementBook?     @relation(fields: [measurementBookId], references: [id])
  runningBillId         String?
  runningBill           RunningBill?         @relation(fields: [runningBillId], references: [id])
  documentType          DocumentType         @default(OTHER)
  documentNumber        String               @unique
  fileName              String?
  // Legacy manually-typed URL — retired from the upload UI (Form 58 redesign: Documents module)
  // but the column stays so documents created before this milestone still resolve. New uploads
  // use filePath/mimeType/fileSizeBytes instead, served through an authenticated download route.
  fileUrl               String?
  filePath              String?
  mimeType              String?
  fileSizeBytes         Int?
  notes                 String?
  uploadedAt            DateTime             @default(now())
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([companyId])
  @@index([projectId])
  @@index([siteId])
  @@index([dprId])
  @@index([measurementBookId])
  @@index([runningBillId])
}
