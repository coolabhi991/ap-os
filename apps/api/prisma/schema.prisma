model Project {
  id            String        @id @default(cuid())
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id])
  clientId      String?
  client        Client?       @relation(fields: [clientId], references: [id])
  projectTypeId String?
  projectType   ProjectType?  @relation(fields: [projectTypeId], references: [id])
  name          String
  // System-generated, permanent, read-only — derived from name initials at creation time.
  code          String?
  description   String?
  location      String?
  manager       String?
  status        ProjectStatus @default(PLANNING)
  contractValue Decimal       @default(0) @db.Decimal(12, 2)
  progress      Int           @default(0)
  startDate     DateTime?
  endDate       DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  purchaseRequisitions PurchaseRequisition[]
  purchaseOrders       PurchaseOrder[]
  materialReceipts     MaterialReceipt[]
  inventoryEntries     Inventory[]
  materialIssues       MaterialIssue[]
  stockLedgerEntries   StockLedgerEntry[]
  labours              Labour[]
  equipments           Equipment[]
  runningBills         RunningBill[]
  measurementBooks     MeasurementBook[]
  expenses             Expense[]
  payments             Payment[]
  documents            Document[]
  vendorBills          VendorBill[]
  vendorPayments       VendorPayment[]
  labourGroups         LabourGroup[]
  labourAttendances    LabourAttendance[]
  labourAdvances       LabourAdvance[]
  labourPayments       LabourPayment[]
  subWorks             SubWork[]
  dailyProgressReports DailyProgressReport[]
  runningBillPayments  RunningBillPayment[]
  bankTransactions     BankTransaction[]
  sites                Site[]

  @@unique([companyId, code])
}

/**
 * Site — the operational unit inside a Project (Project → Sites → Site Workspace).
 * A Project can have multiple physical work sites (e.g. separate work orders/villages
 * under one client contract); every day-to-day operational record (Sub Work, DPR,
 * Measurement Book, Running Bill, Expense, Labour Attendance) is scoped to a Site, not
 * directly to the Project. Contract/statutory figures below are entered once per Site
 * (mirrors ProjectContractInfo's role at the Project level, but these are the values the
 * Site Workspace Overview tab actually displays and edits).
 */
model Site {
  id                   String        @id @default(cuid())
  companyId            String
  company              Company       @relation(fields: [companyId], references: [id])
  projectId            String
  project              Project       @relation(fields: [projectId], references: [id])
  name                 String
  village              String?
  taluka               String?
  district             String?
  engineer             String?
  siteType             SiteType      @default(OWN_SITE)
  status               ProjectStatus @default(PLANNING)
  contractValue        Decimal       @default(0) @db.Decimal(14, 2)
  emdValue             Decimal       @default(0) @db.Decimal(14, 2)
  securityDeposit      Decimal       @default(0) @db.Decimal(14, 2)
  performanceGuarantee Decimal       @default(0) @db.Decimal(14, 2)
  workOrderDate        DateTime?
  // "Work Order End Date" in the UI — the expected/contractual completion date, always visible.
  completionDate       DateTime?
  // Only ever set once status = COMPLETED; the UI hides this field until then.
  actualCompletionDate DateTime?
  // Work Order Details tab fields — relocated here from the removed ProjectContractInfo model so
  // every Site is self-contained (§ Workflow Refinement milestone, Item 1).
  workOrderNumber       String?
  agreementNumber       String?
  agreementDate         DateTime?
  tenderNumber          String?
  tenderAboveBelowPercent Decimal?  @db.Decimal(5, 2)
  department            String?
  division              String?
  subDivision           String?
  clientEngineer        String?
  defectLiabilityPeriod String?
  gstPercent            Decimal?  @db.Decimal(5, 2)
  // System-generated, permanent, read-only — APC/<ProjectCode>/<FY>/<TalukaCode>/<SiteSeq>.
  // Null only for sites created before the Document Numbering Standard milestone.
  siteCode              String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  subWorks             SubWork[]
  dailyProgressReports DailyProgressReport[]
  measurementBooks     MeasurementBook[]
  runningBills         RunningBill[]
  expenses             Expense[]
  labourAttendances    LabourAttendance[]
  documents            Document[]
  recapRevisions       SiteRecapRevision[]
  siteVisits           SiteVisit[]
  transactionAllocations TransactionAllocation[]
  vendorBills          VendorBill[]
  billItems            SiteBillItem[]
  tenderPercentChangeLogs SiteTenderPercentChangeLog[]
  workOrderExtensions  WorkOrderExtension[]

  @@unique([companyId, siteCode])
  @@index([companyId])
  @@index([projectId])
  @@index([status])
}

/**
 * Audit trail for Site.tenderAboveBelowPercent changes (Form 58 redesign) — every edit from the
 * Work Order Details tab is logged here, never overwritten. RA Bills freeze their own copy of the
 * percent at creation time (RunningBill.tenderAboveBelowPercent), so this log exists purely for
 * traceability of *why* the master value changed, not to recompute anything retroactively.
 */
model SiteTenderPercentChangeLog {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  siteId          String
  site            Site     @relation(fields: [siteId], references: [id])
  previousPercent Decimal? @db.Decimal(5, 2)
  newPercent      Decimal? @db.Decimal(5, 2)
  reason          String
  changedById     String
  changedBy       User     @relation(fields: [changedById], references: [id])
  changedAt       DateTime @default(now())

  @@index([companyId])
  @@index([siteId])
}

/**
 * Work Order Extension History (Project Executive Dashboard milestone) — a Site's original
 * Work Order End Date (Site.completionDate) is never overwritten by an extension; each extension
 * is its own permanent row here. The Projects Executive Dashboard shows only the latest (by
 * createdAt desc) newCompletionDate as "Extension Till Date" — full history stays available via
 * the list endpoint, mirroring SiteTenderPercentChangeLog's audit-log shape above. The letter
 * file reuses the same authenticated-download disk-upload pattern as Document
 * (filePath/mimeType/fileSizeBytes, served only through GET /work-order-extensions/:id/file).
 */
model WorkOrderExtension {
  id                     String   @id @default(cuid())
  companyId              String
  company                Company  @relation(fields: [companyId], references: [id])
  siteId                 String
  site                   Site     @relation(fields: [siteId], references: [id])
  extensionOrderNumber   String
  extensionOrderDate     DateTime
  previousCompletionDate DateTime
  newCompletionDate      DateTime
  reason                 String
  remarks                String?
  letterFileName         String?
  letterFilePath         String?
  letterMimeType         String?
  letterFileSizeBytes    Int?
  createdById            String
  createdBy              User     @relation(fields: [createdById], references: [id])
  createdAt              DateTime @default(now())

  @@index([companyId])
  @@index([siteId])
}

enum GstType {
  NONE
  FIVE
  TWELVE
  EIGHTEEN
  CUSTOM
}

/**
 * Recapitulation Sheet snapshots for a Site — unlimited revisions, exactly one marked
 * Current at a time. A new revision is always INSERTed, never UPDATEd over a prior one
 * (createSiteRecapRevision wraps the insert + "flip previous current off" in a
 * transaction). `snapshot` freezes the full budget/actual/variance-per-cost-head payload
 * (unchanged, powers the existing 4 KPI cards), while the new items/GST/charges/total
 * fields below hold the newer government-contractor BOQ Recapitulation sheet (Sr No/Particular/Qty/
 * Rate/Amount, one row per Sub Work, plus GST + Administration + Other Charges below the
 * table) — additive fields, so revisions saved before this existed simply read back with
 * an empty `items` array and zeroed charges. "Latest approved Recapitulation" (referenced
 * by the Abstract MB module) means the current (isCurrent=true) revision — saving a
 * revision IS the approval step here, there is no separate draft/approve state.
 */
model SiteRecapRevision {
  id                     String               @id @default(cuid())
  companyId              String
  company                Company              @relation(fields: [companyId], references: [id])
  siteId                 String
  site                   Site                 @relation(fields: [siteId], references: [id])
  revisionNo             Int
  isCurrent              Boolean              @default(true)
  label                  String?
  notes                  String?
  snapshot               Json
  gstType                GstType              @default(NONE)
  gstPercent             Decimal              @default(0) @db.Decimal(5, 2)
  administrationCharges  Decimal              @default(0) @db.Decimal(14, 2)
  // Legacy free-form extra charges — [{ label: string, amount: string }]. Superseded by the
  // five named Other Charges fields below for any revision created after the Site Management &
  // Financial Workflow Refinement milestone; kept only so older revisions still display their
  // historical figures unchanged (never rewritten retroactively).
  otherCharges           Json                 @default("[]")
  // Other Charges section (Workflow Refinement milestone) — a fixed, named set rather than a
  // free-form list, per the approved requirement. otherChargesTotal is the sum of these five,
  // stored (not purely derived) to match this model's existing convention of persisting its
  // computed totals (subTotal/gstAmount/grandTotal) rather than recomputing them on every read.
  msebCharges            Decimal              @default(0) @db.Decimal(14, 2)
  royaltyCharges         Decimal              @default(0) @db.Decimal(14, 2)
  testingCharges         Decimal              @default(0) @db.Decimal(14, 2)
  labourCessCharges      Decimal              @default(0) @db.Decimal(14, 2)
  otherRecoveries        Decimal              @default(0) @db.Decimal(14, 2)
  otherChargesTotal      Decimal              @default(0) @db.Decimal(14, 2)
  subTotal               Decimal              @default(0) @db.Decimal(14, 2)
  gstAmount              Decimal              @default(0) @db.Decimal(14, 2)
  grandTotal             Decimal              @default(0) @db.Decimal(14, 2)
  createdById            String
  createdBy              User                 @relation(fields: [createdById], references: [id])
  createdAt              DateTime             @default(now())

  items                  RecapitulationItem[]
  seededMeasurementBooks MeasurementBook[]

  @@unique([siteId, revisionNo])
  @@index([companyId])
  @@index([siteId])
  @@index([isCurrent])
}

/**
 * One row of the Recapitulation Register grid — the Site's primary planning/costing/execution
 * line item (Workflow Refinement milestone: Recapitulation replaces Sub Work as the module users
 * directly manage; the "Sub Works" tab is gone). Users freely Add/Insert/Delete/Reorder these
 * rows on the current (isCurrent) revision, editing in place — a new revision is only created
 * when the user explicitly locks/snapshots one for the audit trail, not on every edit.
 *
 * Each row still transparently owns a linked SubWork row (auto-created/renamed together with
 * this item) purely so the ~10 other models that already tag `subWorkId` (DPR, Expense,
 * VendorBill, MaterialIssue, LabourAttendance, MeasurementBook, RunningBill, SiteBillItem)
 * continue to work unchanged — entering a row here is entering it everywhere those modules read
 * from ("Enter Once, Use Everywhere"), without a cross-module schema migration. `subWorkId` is
 * nullable only so a row surviving from an old revision whose SubWork was later deleted can still
 * be read. `amount` is always server-recomputed as qty * rate — never trusted from the client.
 */
model RecapitulationItem {
  id                  String            @id @default(cuid())
  companyId           String
  company             Company           @relation(fields: [companyId], references: [id])
  siteRecapRevisionId String
  siteRecapRevision   SiteRecapRevision @relation(fields: [siteRecapRevisionId], references: [id])
  subWorkId           String?
  subWork             SubWork?          @relation(fields: [subWorkId], references: [id])
  sortOrder           Int               @default(0)
  particular          String
  unit                String?
  qty                 Decimal           @default(0) @db.Decimal(14, 4)
  rate                Decimal           @default(0) @db.Decimal(14, 2)
  amount              Decimal           @default(0) @db.Decimal(14, 2)

  @@index([companyId])
  @@index([siteRecapRevisionId])
  @@index([subWorkId])
}

/**
 * Site Visit Register — one row per planned/completed visit. Planned/Completed/Pending
 * counts on the Site Visits tab are always derived by counting `status`, never stored
 * separately (same "never duplicate a derived total" rule used everywhere else).
 */
model SiteVisit {
  id          String          @id @default(cuid())
  companyId   String
  company     Company         @relation(fields: [companyId], references: [id])
  siteId      String
  site        Site            @relation(fields: [siteId], references: [id])
  visitDate   DateTime        @default(now())
  visitedBy   String?
  purpose     String?
  remarks     String?
  photos      Json?
  status      SiteVisitStatus @default(PLANNED)
  createdById String
  createdBy   User            @relation(fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([companyId])
  @@index([siteId])
  @@index([status])
  @@index([visitDate])
}

/**
 * The master contract record for a Project — Work Order / Agreement / Tender references,
 * the government department hierarchy, and the statutory percentages (Security Deposit,
 * Performance Guarantee, GST). Deliberately a separate 1:1 table rather than more columns on
 * Project: these fields are specific to the new "Contract Information" tab and mostly apply
 * only to government/PWD-style contracts, so keeping them off the base Project row matches the
 * existing convention of isolating tab-specific data (e.g. SubWork's budget fields). Contract
 * Value itself is NOT duplicated here — it stays solely on Project.contractValue and is
 * read/written through it, per the "one source of truth" rule used everywhere else in this app.
 */

/**
 * A project's own breakdown of work (e.g. "Foundation", "Superstructure", "Plumbing") —
 * never hardcoded, since every project defines its own set. Each Sub Work carries its
 * own budget; actual cost is never stored here — it's always computed on demand from
 * the existing cost-bearing modules (Expense, VendorBill, LabourAttendance, MaterialIssue)
 * tagged with this subWorkId, via project-control-center.service.ts. This avoids a second,
 * duplicate ledger of financial data.
 */
model SubWork {
  id                 String        @id @default(cuid())
  companyId          String
  company            Company       @relation(fields: [companyId], references: [id])
  projectId          String
  project            Project       @relation(fields: [projectId], references: [id])
  siteId             String
  site               Site          @relation(fields: [siteId], references: [id])
  name               String
  startDate          DateTime?
  endDate            DateTime?
  status             SubWorkStatus @default(PLANNED)
  remarks            String?
  sortOrder          Int           @default(0)
  // Planned budget, broken down by cost head — entered by the engineer/PM. The total budget
  // is NEVER stored; it is always computed on demand as the sum of these 7 fields, in both
  // sub-work.service.ts (SubWork DTO) and project-control-center.service.ts. Mirrors the
  // existing rule that Actual Cost is never stored either — both totals are always derived.
  budgetMaterial     Decimal       @default(0) @db.Decimal(14, 2)
  budgetLabour       Decimal       @default(0) @db.Decimal(14, 2)
  budgetMachinery    Decimal       @default(0) @db.Decimal(14, 2)
  budgetFuel         Decimal       @default(0) @db.Decimal(14, 2)
  budgetSiteExpenses Decimal       @default(0) @db.Decimal(14, 2)
  budgetVendorBills  Decimal       @default(0) @db.Decimal(14, 2)
  budgetOther        Decimal       @default(0) @db.Decimal(14, 2)
  // Physical Progress is entered manually by the engineer — it is NEVER derived from cost.
  // Financial Progress (Actual Cost / Budget) is always computed on demand in
  // project-control-center.service.ts and intentionally not stored here.
  physicalProgress   Int           @default(0)
  progressUpdatedAt  DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  materialIssues       MaterialIssue[]
  expenses             Expense[]
  vendorBills          VendorBill[]
  labourAttendances    LabourAttendance[]
  dailyProgressReports DailyProgressReport[]
  measurementBooks     MeasurementBook[]
  runningBills         RunningBill[]
  recapitulationItems  RecapitulationItem[]
  measurementBookItems MeasurementBookItem[]
  siteBillItems        SiteBillItem[]

  @@index([companyId])
  @@index([projectId])
  @@index([siteId])
  @@index([status])
}

/**
 * Daily Progress Report — the official daily site diary. Deliberately stores almost nothing
 * that already lives elsewhere: Labour/Machinery/Material figures are pulled live from
 * LabourAttendance/Expense/MaterialReceipt/MaterialIssue at read time (see dpr.service.ts).
 * The 4 labour-count fields and manualMachineryEntries below are the ONLY sanctioned
 * exceptions — they hold an editable snapshot (auto-filled from live data, then optionally
 * hand-adjusted by the engineer), never a second source of truth.
 */
model DailyProgressReport {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id])
  siteId       String
  siteRecord   Site     @relation(fields: [siteId], references: [id])
  subWorkId    String?
  subWork      SubWork? @relation(fields: [subWorkId], references: [id])
  dprNumber    String   @unique
  reportDate   DateTime @default(now())
  site         String?
  engineerId   String?
  engineer     User?    @relation("DPREngineer", fields: [engineerId], references: [id])
  contractorId String?
  contractor   Vendor?  @relation(fields: [contractorId], references: [id])
  weather      String?
  shift        Shift    @default(DAY)
  remarks      String?

  // Work Progress
  workDone               String?
  plannedWork            String?
  physicalProgressUpdate Int?
  delayReason            String?
  instructions           String?

  // Labour Summary — auto-filled from LabourAttendance at creation time, editable thereafter.
  // Total Labour is intentionally never stored — always the sum of these 4, computed in dpr.service.ts.
  labourSkilled          Int     @default(0)
  labourUnskilled        Int     @default(0)
  labourSupervisor       Int     @default(0)
  labourOperator         Int     @default(0)
  labourManuallyAdjusted Boolean @default(false)

  // Machinery Summary is normally pulled live from Expense (category "Machinery") for this
  // date/project — these manual entries exist only for machines used but not yet logged as
  // a Site Expense, so the DPR isn't blocked waiting on bookkeeping.
  manualMachineryEntries Json?

  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdById String
  createdBy   User      @relation("DPRCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  visitors     DPRVisitor[]
  siteProblems DPRSiteProblem[]
  documents    Document[]
  emailLogs    DPREmailLog[]

  @@unique([companyId, projectId, reportDate, shift])
  @@index([companyId])
  @@index([projectId])
  @@index([siteId])
  @@index([subWorkId])
  @@index([reportDate])
  @@index([isDeleted])
}

model DPRVisitor {
  id          String              @id @default(cuid())
  companyId   String
  company     Company             @relation(fields: [companyId], references: [id])
  dprId       String
  dpr         DailyProgressReport @relation(fields: [dprId], references: [id])
  visitorType VisitorType
  name        String?
  remarks     String?
  createdAt   DateTime            @default(now())

  @@index([companyId])
  @@index([dprId])
}

model DPRSiteProblem {
  id          String              @id @default(cuid())
  companyId   String
  company     Company             @relation(fields: [companyId], references: [id])
  dprId       String
  dpr         DailyProgressReport @relation(fields: [dprId], references: [id])
  problemType SiteProblemType
  description String?
  createdAt   DateTime            @default(now())

  @@index([companyId])
  @@index([dprId])
}

/**
 * Audit log of DPR emails sent — recipients/attachments actually delivered, for traceability.
 */
model DPREmailLog {
  id            String              @id @default(cuid())
  companyId     String
  company       Company             @relation(fields: [companyId], references: [id])
  dprId         String
  dpr           DailyProgressReport @relation(fields: [dprId], references: [id])
  recipients    Json
  includedExcel Boolean             @default(false)
  sentById      String
  sentBy        User                @relation("DPREmailSentBy", fields: [sentById], references: [id])
  sentAt        DateTime            @default(now())
  status        String              @default("SENT")
