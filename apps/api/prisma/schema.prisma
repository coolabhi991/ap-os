generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  ACCOUNTANT
  ENGINEER
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProcurementStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
}

enum ReceiptStatus {
  PENDING
  IN_TRANSIT
  RECEIVED
  PARTIALLY_RECEIVED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  FAILED
}

enum DocumentType {
  CONTRACT
  DRAWING
  INVOICE
  PHOTO
  REPORT
  OTHER
}

enum ExpenseType {
  MATERIAL
  LABOUR
  EQUIPMENT
  OVERHEAD
  OTHER
}

enum LabourCategory {
  SKILLED
  SEMI_SKILLED
  UNSKILLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
}

enum EquipmentStatus {
  RUNNING
  IDLE
  BREAKDOWN
  MAINTENANCE
  DECOMMISSIONED
}

enum BillStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PAID
  CANCELLED
}

enum BillType {
  RA_BILL
  FINAL_BILL
  ADVANCE_BILL
}

enum MeasurementStatus {
  DRAFT
  VERIFIED
  APPROVED
  REVISED
}

enum InventoryStatus {
  HEALTHY
  LOW
  CRITICAL
  OUT_OF_STOCK
}

model Company {
  id             String   @id @default(cuid())
  name           String
  gstNumber      String?
  panNumber      String?
  email          String?
  phone          String?
  address        String?
  city           String?
  state          String?
  country        String?
  pincode        String?
  logo           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users                  User[]
  roles                  Role[]
  clients                Client[]
  projectTypes           ProjectType[]
  projects               Project[]
  vendors                Vendor[]
  purchaseRequisitions   PurchaseRequisition[]
  purchaseOrders         PurchaseOrder[]
  materialReceipts       MaterialReceipt[]
  inventoryEntries       Inventory[]
  materialIssues         MaterialIssue[]
  labours                Labour[]
  equipments             Equipment[]
  runningBills           RunningBill[]
  measurementBooks       MeasurementBook[]
  expenses               Expense[]
  payments               Payment[]
  documents              Document[]
}

model Role {
  id        String   @id @default(cuid())
  name      UserRole
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, companyId])
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  active    Boolean  @default(true)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Client {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  name            String
  contactPerson   String?
  email           String?
  phone           String?
  address         String?
  gstNumber       String?
  panNumber       String?
  status          String   @default("Active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  projects        Project[]
  documents       Document[]
}

model ProjectType {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projects    Project[]
}

model Project {
  id                  String   @id @default(cuid())
  companyId           String
  company             Company  @relation(fields: [companyId], references: [id])
  clientId            String?
  client              Client?  @relation(fields: [clientId], references: [id])
  projectTypeId       String?
  projectType         ProjectType? @relation(fields: [projectTypeId], references: [id])
  name                String
  code                String?
  description         String?
  location            String?
  status              ProjectStatus @default(PLANNING)
  contractValue       Decimal @default(0) @db.Decimal(12, 2)
  progress            Int @default(0)
  startDate           DateTime?
  endDate             DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  purchaseRequisitions PurchaseRequisition[]
  purchaseOrders       PurchaseOrder[]
  materialReceipts     MaterialReceipt[]
  inventoryEntries     Inventory[]
  materialIssues       MaterialIssue[]
  labours              Labour[]
  equipments           Equipment[]
  runningBills         RunningBill[]
  measurementBooks     MeasurementBook[]
  expenses             Expense[]
  payments             Payment[]
  documents            Document[]
}

model Vendor {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  gstNumber     String?
  panNumber     String?
  category      String?
  status        String   @default("Active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  purchaseOrders     PurchaseOrder[]
  purchaseRequisitions PurchaseRequisition[]
  expenses           Expense[]
  payments           Payment[]
  documents          Document[]
}

model PurchaseRequisition {
  id                String   @id @default(cuid())
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id])
  projectId         String?
  project           Project? @relation(fields: [projectId], references: [id])
  vendorId          String?
  vendor            Vendor?  @relation(fields: [vendorId], references: [id])
  requisitionNumber String   @unique
  title             String
  description       String?
  requiredDate      DateTime?
  status            ProcurementStatus @default(DRAFT)
  totalAmount       Decimal @default(0) @db.Decimal(12, 2)
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  purchaseOrders    PurchaseOrder[]
  documents         Document[]
}

model PurchaseOrder {
  id                String   @id @default(cuid())
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id])
  projectId         String?
  project           Project? @relation(fields: [projectId], references: [id])
  vendorId          String?
  vendor            Vendor?  @relation(fields: [vendorId], references: [id])
  requisitionId     String?
  requisition       PurchaseRequisition? @relation(fields: [requisitionId], references: [id])
  poNumber          String   @unique
  orderDate         DateTime @default(now())
  expectedDate      DateTime?
  amount            Decimal @default(0) @db.Decimal(12, 2)
  status            ProcurementStatus @default(DRAFT)
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  materialReceipts  MaterialReceipt[]
  payments          Payment[]
  documents         Document[]
}

model MaterialReceipt {
  id                String   @id @default(cuid())
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id])
  projectId         String?
  project           Project? @relation(fields: [projectId], references: [id])
  purchaseOrderId   String?
  purchaseOrder     PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  inventoryId       String?
  inventory         Inventory? @relation(fields: [inventoryId], references: [id])
  receiptNumber     String   @unique
  receivedDate      DateTime @default(now())
  itemName          String
  quantity          Decimal @default(0) @db.Decimal(12, 2)
  unit              String?
  status            ReceiptStatus @default(PENDING)
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  documents         Document[]
}

model Inventory {
  id                String   @id @default(cuid())
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id])
  projectId         String?
  project           Project? @relation(fields: [projectId], references: [id])
  itemName          String
  category          String?
  unit              String?
  openingBalance    Decimal @default(0) @db.Decimal(12, 2)
  receiptsQuantity  Decimal @default(0) @db.Decimal(12, 2)
  issuesQuantity    Decimal @default(0) @db.Decimal(12, 2)
  currentStock      Decimal @default(0) @db.Decimal(12, 2)
  location          String?
  status            InventoryStatus @default(HEALTHY)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  materialReceipts  MaterialReceipt[]
  materialIssues    MaterialIssue[]
}

model MaterialIssue {
  id                String   @id @default(cuid())
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id])
  projectId         String?
  project           Project? @relation(fields: [projectId], references: [id])
  inventoryId       String?
  inventory         Inventory? @relation(fields: [inventoryId], references: [id])
  issueNumber       String   @unique
  issuedDate        DateTime @default(now())
  itemName          String
  quantity          Decimal @default(0) @db.Decimal(12, 2)
  unit              String?
  issuedTo          String?
  issuedBy          String?
  status            ProcurementStatus @default(APPROVED)
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Labour {
  id               String          @id @default(cuid())
  companyId        String
  company          Company         @relation(fields: [companyId], references: [id])
  projectId        String?
  project          Project?        @relation(fields: [projectId], references: [id])
  name             String
  contractorName   String?
  designation      String?
  category         LabourCategory  @default(UNSKILLED)
  shift            String?
  dailyWage        Decimal?        @db.Decimal(12, 2)
  overtimeRate     Decimal?        @db.Decimal(12, 2)
  attendanceStatus AttendanceStatus @default(PRESENT)
  status           String          @default("Active")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([companyId])
  @@index([projectId])
  @@index([category])
  @@index([attendanceStatus])
}

model Equipment {
  id                   String          @id @default(cuid())
  companyId            String
  company              Company         @relation(fields: [companyId], references: [id])
  projectId            String?
  project              Project?        @relation(fields: [projectId], references: [id])
  assetNumber          String?
  assetName            String
  equipmentType        String
  registrationNumber   String?
  operatorName         String?
  fuelConsumption      Decimal?        @db.Decimal(12, 2)
  runningHours         Decimal?        @db.Decimal(10, 2)
  maintenanceSchedule  String?
  maintenanceDue       DateTime?
  breakdownNotes       String?
  currentSite          String?
  status               EquipmentStatus @default(RUNNING)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([companyId])
  @@index([projectId])
  @@index([status])
}

model MeasurementBook {
  id               String            @id @default(cuid())
  companyId        String
  company          Company           @relation(fields: [companyId], references: [id])
  projectId        String?
  project          Project?          @relation(fields: [projectId], references: [id])
  mbNumber         String            @unique
  mbDate           DateTime?
  pageNumber       String?
  boqItem          String?
  itemDescription  String?
  unit             String?
  previousQuantity Decimal           @default(0) @db.Decimal(12, 4)
  currentQuantity  Decimal           @default(0) @db.Decimal(12, 4)
  totalQuantity    Decimal           @default(0) @db.Decimal(12, 4)
  boqRate          Decimal           @default(0) @db.Decimal(14, 2)
  extraItemRate    Decimal           @default(0) @db.Decimal(14, 2)
  previousAmount   Decimal           @default(0) @db.Decimal(14, 2)
  currentAmount    Decimal           @default(0) @db.Decimal(14, 2)
  totalAmount      Decimal           @default(0) @db.Decimal(14, 2)
  measuredBy       String?
  checkedBy        String?
  verifiedBy       String?
  approvedBy       String?
  status           MeasurementStatus @default(DRAFT)
  remarks          String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  runningBills     RunningBill[]

  @@index([companyId])
  @@index([projectId])
  @@index([status])
}

model RunningBill {
  id                      String           @id @default(cuid())
  companyId               String
  company                 Company          @relation(fields: [companyId], references: [id])
  projectId               String?
  project                 Project?         @relation(fields: [projectId], references: [id])
  measurementBookId       String?
  measurementBook         MeasurementBook? @relation(fields: [measurementBookId], references: [id])
  billType                BillType         @default(RA_BILL)
  billNumber              String           @unique
  billPeriodFrom          DateTime?
  billPeriodTo            DateTime?
  grossAmount             Decimal          @default(0) @db.Decimal(14, 2)
  previousCertifiedAmount Decimal          @default(0) @db.Decimal(14, 2)
  currentCertifiedAmount  Decimal          @default(0) @db.Decimal(14, 2)
  totalCertifiedAmount    Decimal          @default(0) @db.Decimal(14, 2)
  securityDeposit         Decimal          @default(0) @db.Decimal(14, 2)
  royaltyRecovery         Decimal          @default(0) @db.Decimal(14, 2)
  mobilizationRecovery    Decimal          @default(0) @db.Decimal(14, 2)
  otherRecovery           Decimal          @default(0) @db.Decimal(14, 2)
  gstAmount               Decimal          @default(0) @db.Decimal(14, 2)
  netPayable              Decimal          @default(0) @db.Decimal(14, 2)
  amountReceived          Decimal          @default(0) @db.Decimal(14, 2)
  outstandingAmount       Decimal          @default(0) @db.Decimal(14, 2)
  submissionDate          DateTime?
  approvalDate            DateTime?
  paymentDate             DateTime?
  submittedBy             String?
  checkedBy               String?
  approvedBy              String?
  status                  BillStatus       @default(DRAFT)
  remarks                 String?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  @@index([companyId])
  @@index([projectId])
  @@index([measurementBookId])
  @@index([status])
  @@index([billType])
}

model Expense {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  projectId     String?
  project       Project? @relation(fields: [projectId], references: [id])
  vendorId      String?
  vendor        Vendor?  @relation(fields: [vendorId], references: [id])
  expenseNumber String   @unique
  expenseDate   DateTime @default(now())
  type          ExpenseType @default(OTHER)
  amount        Decimal @default(0) @db.Decimal(12, 2)
  status        PaymentStatus @default(PENDING)
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  payments      Payment[]
}

model Payment {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  projectId       String?
  project         Project? @relation(fields: [projectId], references: [id])
  vendorId        String?
  vendor          Vendor?  @relation(fields: [vendorId], references: [id])
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  expenseId       String?
  expense         Expense? @relation(fields: [expenseId], references: [id])
  paymentNumber   String   @unique
  paymentDate     DateTime @default(now())
  amount          Decimal @default(0) @db.Decimal(12, 2)
  mode            String?
  status          PaymentStatus @default(PENDING)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Document {
  id                   String   @id @default(cuid())
  companyId            String
  company              Company  @relation(fields: [companyId], references: [id])
  projectId            String?
  project              Project? @relation(fields: [projectId], references: [id])
  clientId             String?
  client               Client?  @relation(fields: [clientId], references: [id])
  vendorId             String?
  vendor               Vendor?  @relation(fields: [vendorId], references: [id])
  purchaseOrderId      String?
  purchaseOrder        PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  purchaseRequisitionId String?
  purchaseRequisition  PurchaseRequisition? @relation(fields: [purchaseRequisitionId], references: [id])
  materialReceiptId    String?
  materialReceipt      MaterialReceipt? @relation(fields: [materialReceiptId], references: [id])
  documentType         DocumentType @default(OTHER)
  documentNumber       String   @unique
  fileName             String?
  fileUrl              String?
  notes                String?
  uploadedAt           DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}